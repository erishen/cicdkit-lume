{
  "name": "cicdkit-lume-web",
  "private": true,
  "version": "0.1.0",
  "description": "cicdkit-lume 控制面的 React 控制台：esbuild 打包到 www/app.js，由 Lume docroot 直接伺服。",
  "type": "module",
  "scripts": {
    "build": "esbuild src/web/app.tsx --bundle --minify --format=esm --jsx=automatic --outfile=www/app.js",
    "dev": "esbuild src/web/app.tsx --bundle --format=esm --jsx=automatic --outfile=www/app.js --watch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.24.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.0"
  },
  "license": "MIT"
}
