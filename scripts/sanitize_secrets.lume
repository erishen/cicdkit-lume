// scripts/sanitize_secrets.lume —— 清洗项目配置里明文存放的密钥
//
// 背景：从 cicdkit 迁移过来的真实项目里，`build.build_args` / `deploy.ssh_run_args`
// 直接存着 `LLM_API_KEY=sk-...`、`CODEX_VISIT_PIN=...` 这类真值（cicdkit 时代它们
// 就是构建/运行参数）。控制面读出侧已经过 `redact.mask_log()`，但库里仍是明文：
// 任何能读 store.db 或备份文件的人都拿得到。
//
// 这个脚本按字段递归走一遍项目 JSON，把命中的值换成 `********`。
// **默认干跑**，只列出「哪个项目的哪个路径会被改」，不打印任何明文；
// APPLY=1 才写库（写之前请自己备份 store.db，Makefile 里的 sanitize 目标会做）。
//
//   LUME_DATA=.data ./vendor/lume/bin/lume scripts/sanitize_secrets.lume
//   LUME_DATA=.data APPLY=1 ./vendor/lume/bin/lume scripts/sanitize_secrets.lume
//
// 注意：这不是无损操作。清洗后这些构建参数会变成掩码，依赖它们注入密钥的构建
// 会失效——要么把密钥改成从环境变量/secret 文件读取，要么确认该构建不再需要它。

import "../src/store.lume" as store;
import "../src/redact.lume" as redact;

let want_apply = (str(env("APPLY")) == "1");
let hits = { n: 0, items: [] };

store.init();

// 空库先做一次旧数据导入，这样「迁移完立刻清洗」是一条命令。
if (len(store.project_rows()) == 0) {
  print("legacy import: " + stringify(store.import_legacy()));
}

let rows = store.project_rows();
print("scan: " + str(len(rows)) + " project(s), apply=" + str(want_apply));

let i = 0;
while (i < len(rows)) {
  let row = rows[i];
  let id = str(get(row, "id", ""));
  let p = store.parse_json(get(row, "json", ""), null);
  if (p != null) {
    hits.n = 0;
    hits.items = [];
    let np = redact.mask_values(p, str(id), hits);
    if (hits.n > 0) {
      print("  " + id + ": " + str(hits.n) + " secret value(s)");
      let j = 0;
      while (j < len(hits.items)) {
        print("    - " + str(hits.items[j]));
        j = j + 1;
      }
      if (want_apply) {
        // 用列里的 created_ts 覆盖回对象，避免 put_project 把它重置成 now()。
        put(np, "created_ts", int(get(row, "created_ts", 0)));
        let r = store.put_project(np, false);
        if (r.ok) { print("    ✓ 已落库"); } else { print("    ✗ 落库失败：" + str(r.err)); }
      }
    } else {
      print("  " + id + ": clean");
    }
  }
  i = i + 1;
}

// 历史运行/部署的 json 里存着当初执行过的完整命令行（含 `-e LLM_API_KEY=sk-...`）。
// 这里按字符串级脱敏（mask_log），不递归：这些是历史记录，改结构没有意义。
// 运行表、部署表分开处理，便于报告「命中在历史里」而不是项目配置里。
let hist = { runs: 0, deployments: 0 };
func scrub_history(table, rows) {
  let i = 0;
  while (i < len(rows)) {
    let row = rows[i];
    let id = str(get(row, "id", ""));
    let s = str(get(row, "json", ""));
    let m = redact.mask_log(s);
    if (m != s) {
      if (table == "runs") { put(hist, "runs", int(get(hist, "runs", 0)) + 1); }
      if (table == "deployments") { put(hist, "deployments", int(get(hist, "deployments", 0)) + 1); }
      if (want_apply) {
        let r = store.put_json(table, id, m);
        print("  " + table + " " + id + " → " + (r.ok ? "已脱敏落库" : "落库失败：" + str(r.err)));
      }
    }
    i = i + 1;
  }
}

scrub_history("runs", store.run_rows());
scrub_history("deployments", store.deployment_rows());
print("history: runs=" + str(get(hist, "runs", 0)) + " deployments=" + str(get(hist, "deployments", 0)) + "（APPLY=1 才写库）");

print("done: apply=" + str(want_apply) + "（APPLY=1 才写库）");
