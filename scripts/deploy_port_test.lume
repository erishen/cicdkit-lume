// scripts/deploy_port_test.lume — 发布环境/端口规则自测（不启服务器）
//
//   LUME_DATA=/tmp/lume_test_deploy_port ./vendor/lume/bin/lume scripts/deploy_port_test.lume
//
// 覆盖：腾讯云=测试/阿里云=生产、测试缺省 8080 且保留已有端口、
// 生产必须显式传端口、端口范围校验、显式 environment 覆盖名称推断。
import "../src/validate.lume" as validate;

let st = { fails: 0, checks: 0 };
func ok(label, cond) {
  put(st, "checks", int(get(st, "checks", 0)) + 1);
  if (cond) { print("  ok " + label); }
  else {
    print("  FAIL " + label);
    put(st, "fails", int(get(st, "fails", 0)) + 1);
  }
}

print("deploy-port: env");
ok("腾讯云推断为测试", validate.target_env({}, "腾讯云") == "test");
ok("阿里云推断为生产", validate.target_env({}, "阿里云") == "prod");
ok("显式 environment 覆盖名称", validate.target_env({ environment: "prod" }, "腾讯云") == "prod");

print("deploy-port: test");
let t1 = { method: "ssh", ssh_container_port: "8081" };
let r1 = validate.apply_target_port(t1, "腾讯云", "");
ok("测试目标缺省 8080", get(r1, "ok", false) and get(t1, "ssh_probe_port", "") == "8080");

let t2 = { method: "ssh", ssh_probe_port: "8082", ssh_container_port: "8081" };
let r2 = validate.apply_target_port(t2, "腾讯云", "");
ok("测试目标旧端口被 8080 覆盖", get(r2, "ok", false) and get(t2, "ssh_probe_port", "") == "8080");

let t3 = { method: "ssh", ssh_probe_port: "8080" };
let r3 = validate.apply_target_port(t3, "腾讯云", "9090");
ok("测试目标允许发布时改端口", get(r3, "ok", false) and get(t3, "ssh_probe_port", "") == "9090");

print("deploy-port: prod");
let p1 = { method: "ssh", ssh_probe_port: "8095" };
let rp1 = validate.apply_target_port(p1, "阿里云", "");
ok("生产目标不读配置端口", not get(rp1, "ok", false) and get(p1, "ssh_probe_port", "") == "8095");

let p2 = { method: "ssh", ssh_probe_port: "8095" };
let rp2 = validate.apply_target_port(p2, "阿里云", "8096");
ok("生产目标显式端口生效", get(rp2, "ok", false) and get(p2, "ssh_probe_port", "") == "8096");

let p3 = { method: "ssh" };
let rp3 = validate.apply_target_port(p3, "阿里云", "70000");
ok("端口超出范围被拒", not get(rp3, "ok", false));

let p4 = { method: "ssh" };
let rp4 = validate.apply_target_port(p4, "阿里云", "abc");
ok("非数字端口被拒", not get(rp4, "ok", false));

let p5 = { method: "local-k3s" };
let rp5 = validate.apply_target_port(p5, "阿里云", "");
ok("非 SSH 目标不要求端口", get(rp5, "ok", false));

print("deploy-port: " + str(get(st, "checks", 0)) + " checks, " + str(get(st, "fails", 0)) + " failures");
