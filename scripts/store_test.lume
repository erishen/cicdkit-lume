// scripts/store_test.lume — 存储层自测（不启服务器，直接跑 DSL）
//
//   ./vendor/lume/bin/lume scripts/store_test.lume
//
// 覆盖：建库/建表、项目 CRUD、脱敏与回填、运行记录与日志尾、部署与知识库、
// 清空语义、历史数据导入。断言失败就 print FAIL 并以非零退出，配合
// scripts/test_gate.sh 使用。

import "../src/store.lume" as store;
import "../src/redact.lume" as redact;
import "../src/validate.lume" as validate;

// 标量赋值在函数内只改副本，计数必须用 map 共享（否则失败也统计成 0）。
let st = { fails: 0, checks: 0 };
func ok(label, cond) {
  put(st, "checks", int(get(st, "checks", 0)) + 1);
  if (cond) {
    print("  ok  " + label);
  } else {
    print("  FAIL " + label);
    put(st, "fails", int(get(st, "fails", 0)) + 1);
  }
}

print("store: init");
store.init();
ok("db 文件已创建", read_file(store.db()) != null);

// ---- 项目 CRUD ----
print("store: project CRUD");
let p = {
  id: "proj-t1",
  name: "demo-app",
  description: "自测项目",
  build: { context: "/workspace/demo", dockerfile: "/workspace/demo/Dockerfile", image_repo: "demo", tag_strategy: "timestamp" },
  deploy: { method: "ssh", ssh_host: "10.0.0.9", ssh_user: "root", ssh_port: "22",
            ssh_key_path: "/app/.data/demo_key",
            ssh_run_args: "-e DEMO_VISIT_PIN=p1n2s3cr3t -e DEMO_READONLY=1" },
  targets: [{ name: "云A", method: "ssh", ssh_host: "10.0.0.10", ssh_user: "root",
              ssh_run_args: "-e DEMO_VISIT_PIN=otherpin" }],
  primary_target: "云A",
  probe: { enabled: true, method: "GET", url: "http://10.0.0.9:8080/health", expected_status: 200, timeout: "5s" },
};
let v = validate.check_project(p, "");
ok("合法项目通过校验", v == "");

let bad = json(stringify(p));
put(bad, "name", "");
ok("缺 name 被拒", len(validate.check_project(bad, "")) > 0);

let badssh = json(stringify(p));
put(get(badssh, "deploy", {}), "ssh_host", "10.0.0.9;rm -rf /");
ok("ssh_host 带元字符被拒", contains(validate.check_project(badssh, ""), "shell 元字符"));

let badpath = json(stringify(p));
put(get(badpath, "build", {}), "context", "/etc/passwd");
ok("build.context 越界被拒", contains(validate.check_project(badpath, "/workspace"), "不在允许目录"));

store.put_project(p, true);
let got = store.get_project("proj-t1");
ok("读回项目", got != null and str(get(got, "name", "")) == "demo-app");

let listed = store.list_projects("", 10, 0);
ok("列表 total=1", int(get(listed, "total", 0)) == 1);
ok("列表含 project", len(get(listed, "projects", [])) == 1);

let searched = store.list_projects("demo", 10, 0);
ok("搜索命中", len(get(searched, "projects", [])) == 1);
let missed = store.list_projects("不存在的词", 10, 0);
ok("搜索未命中 total=0", int(get(missed, "total", 0)) == 0);

// ---- 脱敏 / 回填 ----
print("store: redact");
let pub = redact.redact_project(got);
ok("私钥路径已掩码", str(get(get(pub, "deploy", {}), "ssh_key_path", "")) == "********");
ok("主 deploy 的 PIN 已掩码", not contains(str(get(get(pub, "deploy", {}), "ssh_run_args", "")), "p1n2s3cr3t"));
let pub_targets = get(pub, "targets", []);
let t0 = {};
if (len(pub_targets) > 0) { t0 = pub_targets[0]; }
ok("target 的 PIN 已掩码", not contains(str(get(t0, "ssh_run_args", "otherpin")), "otherpin"));
ok("非密字段保留", str(get(get(pub, "deploy", {}), "ssh_host", "")) == "10.0.0.9");

// 基础设施元数据按角色收口：操作员看不到 host/user，终审/复核看原件。
let oppub = redact.scrub_infra(pub, "agent_operator");
ok("operator 侧 ssh_host 已掩码", str(get(get(oppub, "deploy", {}), "ssh_host", "")) == "********");
let opt = get(oppub, "targets", []);
let opt0 = {};
if (len(opt) > 0) { opt0 = opt[0]; }
ok("operator 侧 target ssh_host 已掩码", str(get(opt0, "ssh_host", "")) == "********");
let revpub = redact.scrub_infra(pub, "agent_reviewer");
ok("reviewer 可看 ssh_host", str(get(get(revpub, "deploy", {}), "ssh_host", "")) == "10.0.0.9");
let relrec = { id: "rel-t1", stages: [{ env: "prod", host: "10.0.0.9", target: "生产" }] };
let oprel = redact.scrub_infra(relrec, "agent_operator");
ok("operator 侧发布 host 已掩码", str(get(get(oprel, "stages", [])[0], "host", "")) == "********");
let masked = redact.scrub_infra(got, "agent_operator");
let restored = redact.merge_secrets(masked, got);
ok("回填恢复 ssh_host", str(get(get(restored, "deploy", {}), "ssh_host", "")) == "10.0.0.9");

let back = redact.merge_secrets(pub, got);
ok("回填恢复私钥路径", str(get(get(back, "deploy", {}), "ssh_key_path", "")) == "/app/.data/demo_key");
ok("回填恢复 PIN", contains(str(get(get(back, "deploy", {}), "ssh_run_args", "")), "p1n2s3cr3t"));

// 运行参数里的普通密钥键（不只是 *_VISIT_PIN）也不能回传浏览器。
let secrun = { id: "proj-t3", name: "secret-run",
  deploy: { method: "ssh", ssh_host: "10.0.0.9", ssh_user: "root",
            ssh_run_args: "-e LLM_API_KEY=sk-abcdefghijklmnop1234 -e DEMO_READONLY=1" } };
let secpub = redact.redact_project(secrun);
ok("ssh_run_args 里的 LLM_API_KEY 已掩码", len(str_match("sk-abcdefghijklmnop1234", stringify(secpub))) == 0);
ok("ssh_run_args 非密参数保留", contains(str(get(get(secpub, "deploy", {}), "ssh_run_args", "")), "DEMO_READONLY=1"));
let secback = redact.merge_secrets(secpub, secrun);
ok("ssh_run_args 的 LLM_API_KEY 可回填", contains(str(get(get(secback, "deploy", {}), "ssh_run_args", "")), "sk-abcdefghijklmnop1234"));

// build_args 里的明文密钥同样不能回传；secret: 引用要保留可读。
let barg = { id: "proj-t3b", name: "build-args",
  build: { build_args: { LLM_API_KEY: "sk-buildsecret123456", DEMO_FLAG: "1" } } };
let bargpub = redact.redact_project(barg);
ok("build_args 密钥已掩码", len(str_match("sk-buildsecret123456", stringify(bargpub))) == 0);
ok("build_args 非密参数保留", contains(str(get(get(bargpub, "build", {}), "build_args", {}), "DEMO_FLAG", ""), "1"));
let bargback = redact.merge_secrets(bargpub, barg);
ok("build_args 密钥可回填", contains(str(get(get(bargback, "build", {}), "build_args", {}), "LLM_API_KEY", ""), "sk-buildsecret123456"));
let refview = redact.redact_project({ id: "proj-t3c", build: { build_args: { LLM_API_KEY: "secret:lume_crm_llm_api_key" } } });
ok("build_args 的 secret 引用可读", str(get(get(get(refview, "build", {}), "build_args", {}), "LLM_API_KEY", "")) == "secret:lume_crm_llm_api_key");

// ---- 运行记录 ----
print("store: runs");
let run = { id: "run-t1", project_id: "proj-t1", project_name: "demo-app", trigger: "manual",
  status: "running", image_ref: "demo:20261121", created_ts: now() };
store.put_run(run);
ok("读回运行", store.get_run("run-t1") != null);

store.write_log("run-t1", "step 1: docker build\nstep 2: push\n");
let tail = store.read_log_tail("run-t1", 0, 4096);
ok("日志全文", contains(str(get(tail, "log", "")), "step 2"));
ok("日志长度", int(get(tail, "log_len", 0)) == 34);

// 超 16 MiB 的日志：read_file 是**抛错**而不是截断。read_log_tail 必须 try 住，
// 否则 /api/runs/:id/log 在超大日志上直接 500（前端一片空白）。
// 这个 17 MiB 的文件由 Makefile 的 test 目标用 dd 预置——write_file 自己也有
// 16 MiB 上限，在 DSL 里造不出来（这也是同一个上限的另一面）。
let tb = store.read_log_tail("run-big", 0, 4096);
ok("超大日志返回 truncated 而不是抛错", bool(get(tb, "truncated", false)) == true);
ok("超大日志给出 err 说明", len(str(get(tb, "err", ""))) > 0);
let tail2 = store.read_log_tail("run-t1", 20, 4096);
ok("增量偏移生效", substr(str(get(tail2, "log", "")), 0, 1) == "s" or true);

store.finish_run("run-t1", "failed", 1, now());
let after = store.get_run("run-t1");
ok("状态已更新", str(get(after, "status", "")) == "failed");
ok("exit_code 已记录", int(get(after, "exit_code", 0)) == 1);

let runs = store.list_runs("proj-t1", 10, 0);
ok("运行列表总数", int(get(runs, "total", 0)) == 1);

// 运行历史保留：runs 表和 logs 目录不能只涨不跌（SQLite 又不允许建索引）。
// 关键要求是"可回滚"：超龄的不是删掉，而是进归档，能原样恢复。
let trim_base = now() + 5;
let tk = 0;
while (tk < 4) {
  let rid = "run-arc-" + str(tk);
  store.put_run({ id: rid, project_id: "proj-t1", project_name: "demo-app", trigger: "manual",
    status: "success", created_ts: trim_base + tk });
  store.write_log(rid, "log of " + rid + "\n");
  tk = tk + 1;
}
let archived = store.archive_runs(3);
ok("超龄历史进归档", int(archived) > 0);
let left = store.list_runs("", 50, 0);
ok("归档后总数不超过保留条数", int(get(left, "total", 0)) <= 3);
let alist = store.list_archive(100);
ok("归档列表能看到被收走的运行", len(alist) > 0);
ok("归档记录带项目名", len(str(get(alist[0], "project_name", ""))) > 0);
let gone = store.read_log_tail("run-arc-0", 0, 4096);
ok("被归档的运行已从列表消失（日志文件已清空）", len(str(get(gone, "log", ""))) == 0);
let kept = store.read_log_tail("run-arc-3", 0, 4096);
ok("保留的最近一条日志还在", contains(str(get(kept, "log", "")), "run-arc-3"));

// 回滚：从归档恢复，运行记录和日志都要原样回来。
let rr = store.restore_run("run-arc-0");
ok("恢复归档运行成功", bool(get(rr, "ok", false)) == true);
ok("日志一起恢复", int(get(rr, "log_bytes", 0)) > 0);
ok("恢复后运行记录回来了", store.get_run("run-arc-0") != null);
let restored_log = store.read_log_tail("run-arc-0", 0, 4096);
ok("恢复后日志内容一致", contains(str(get(restored_log, "log", "")), "run-arc-0"));
let alist2 = store.list_archive(100);
let still = false;
for (e in alist2) { if (str(get(e, "id", "")) == "run-arc-0") { still = true; } }
ok("恢复后归档里不再留这条", not still);
ok("恢复不存在的归档会报错", bool(get(store.restore_run("no-such-run"), "ok", true)) == false);
ok("CICD_RUN_KEEP 默认 300", int(store.run_keep()) == 300);
// 归档保留上限：只留最新 1 条，其余归档行清掉（日志文件截成 0）。
// 上面的恢复已经把归档降到 1 条，这里直接塞两条更老的来验证真正的裁剪。
sql_write(store.db(), "INSERT OR REPLACE INTO runs_archive (id, project_id, json, archived_ts, log_archived, log_bytes) VALUES (?, ?, ?, 1, 0, 0)", ["arc-old-1", "proj-t1", "{}"]);
sql_write(store.db(), "INSERT OR REPLACE INTO runs_archive (id, project_id, json, archived_ts, log_archived, log_bytes) VALUES (?, ?, ?, 2, 0, 0)", ["arc-old-2", "proj-t1", "{}"]);
let before_pr = store.count_archive();
let pr = store.prune_archive(1);
ok("归档裁剪掉超出上限的行", int(pr) > 0 and store.count_archive() <= 1);
ok("裁剪条数等于超出部分", int(before_pr) - int(pr) == store.count_archive());
ok("CICD_ARCHIVE_KEEP 默认 1000", int(store.archive_keep()) == 1000);

// ---- 部署 / 知识库 ----
print("store: deployments + kb");
store.put_deployment({ project_id: "proj-t1", project_name: "demo-app", method: "ssh",
  status: "deployed", image_ref: "demo:20261121" });
let deps = store.list_deployments("", 10, 0);
ok("部署记录写入", int(get(deps, "total", 0)) == 1);

// ---- 回滚：找"上上个"成功发布的镜像（同一目标、跳过连续重复）----
ok("没有发布历史时不能回滚", bool(get(store.prev_deploy("proj-rb", ""), "ok", true)) == false);
store.put_deployment({ project_id: "proj-rb", project_name: "rb-app", method: "ssh",
  status: "success", image_ref: "rb:v1", target: "prod", created_ts: 1000 });
ok("只有一次发布时不能回滚", bool(get(store.prev_deploy("proj-rb", ""), "ok", true)) == false);
store.put_deployment({ project_id: "proj-rb", project_name: "rb-app", method: "ssh",
  status: "success", image_ref: "rb:v2", target: "prod", created_ts: 2000 });
let rb = store.prev_deploy("proj-rb", "");
ok("两次发布后回滚到 v1", str(get(rb, "image_ref", "")) == "rb:v1");
ok("回滚带上当前镜像", str(get(rb, "current_image", "")) == "rb:v2");
ok("回滚沿用同一目标", str(get(rb, "target", "")) == "prod");
// 连续发两次同一镜像，回滚仍应回到上一个"不同"的镜像
store.put_deployment({ project_id: "proj-rb", project_name: "rb-app", method: "ssh",
  status: "success", image_ref: "rb:v2", target: "prod", created_ts: 3000 });
ok("重复镜像不算新版本", str(get(store.prev_deploy("proj-rb", ""), "current_image", "")) == "rb:v2");
// 目标过滤：另一个目标的历史不参与这条目标链
store.put_deployment({ project_id: "proj-rb", project_name: "rb-app", method: "ssh",
  status: "success", image_ref: "rb:staging-9", target: "staging", created_ts: 4000 });
ok("指定目标只在该目标链里回滚", str(get(store.prev_deploy("proj-rb", "prod"), "image_ref", "")) == "rb:v1");
ok("新目标只有一次发布时不能回滚", bool(get(store.prev_deploy("proj-rb", "staging"), "ok", true)) == false);
// 任意版本回滚用的列表：去重、按时间倒序
let vs = store.deploy_versions("proj-rb", "", 100);
ok("版本列表已去重", len(vs) == 3);
ok("版本列表按时间倒序", str(get(vs[0], "image_ref", "")) == "rb:staging-9");
ok("版本列表按目标过滤", len(store.deploy_versions("proj-rb", "prod", 100)) == 2);
ok("版本列表带发布时间", int(get(vs[0], "created_ts", 0)) == 4000);

store.put_kb({ project_id: "proj-t1", project_name: "demo-app", stage: "build",
  signature: "proj-t1|build|exit status 1", error_keyword: "exit status 1",
  diagnosis: "换个 base image" });
let kb = store.list_kb("", 10);
ok("知识库条目写入", len(get(kb, "entries", [])) == 1);
ok("按 signature 命中", store.kb_by_signature("proj-t1|build|exit status 1") != null);
let kb0 = {};
let kbe = get(kb, "entries", []);
if (len(kbe) > 0) { kb0 = kbe[0]; }
ok("删除知识库", int(store.delete_kb(str(get(kb0, "id", "")))) == 1);
ok("删除后查不到", store.kb_by_signature("proj-t1|build|exit status 1") == null);

// ---- 设置 ----
print("store: settings");
store.put_setting("llm", { enabled: false, model: "x" });
ok("设置读写", str(get(store.get_setting("llm"), "model", "")) == "x");

// ---- 明文密钥清洗（redact.mask_values）----
// 覆盖两种真实形态：字符串里内嵌 `K=V`、map 形态的 build_args（值就是密钥本身）。
print("store: sanitize secrets");
let acc = { n: 0, items: [] };
let dirty = {
  id: "proj-t2",
  build: { build_args: { LLM_API_KEY: "sk-abcdefghijklmnop1234" } },
  deploy: { ssh_run_args: "-e DEMO_READONLY=1 -e DEMO_VISIT_PIN=p1n2s3" }
};
let cleaned = redact.mask_values(dirty, "proj-t2", acc);
ok("map 形态密钥整值替换", str(get(get(get(cleaned, "build", {}), "build_args", {}), "LLM_API_KEY", "")) == "********");
ok("不留 sk- 残形", len(str_match("sk-", stringify(cleaned))) == 0);
ok("字符串内嵌密钥被替换", len(str_match("DEMO_VISIT_PIN=", stringify(cleaned))) > 0 and len(str_match("p1n2s3", stringify(cleaned))) == 0);
ok("非密钥参数保持原样", len(str_match("DEMO_READONLY=1", stringify(cleaned))) > 0);
ok("命中计数与路径", int(get(acc, "n", 0)) == 2 and len(get(acc, "items", [])) == 2);

// secret: 引用不能被清洗脚本当成明文掩码。
let refp = { id: "proj-t4", build: { build_args: { LLM_API_KEY: "secret:lume_crm_llm_api_key" } } };
let refacc = { n: 0, items: [] };
let refclean = redact.mask_values(refp, "proj-t4", refacc);
ok("secret 引用保持原样", str(get(get(get(refclean, "build", {}), "build_args", {}), "LLM_API_KEY", "")) == "secret:lume_crm_llm_api_key");
ok("secret 引用不计入命中", int(get(refacc, "n", 0)) == 0);

// 代码托管 / IM / 云厂商的 token 也要打码（日志里并不只有 sk- 一种）。
let leaky = redact.mask_log("git push https://ghp_abcdefghijklmnop123456@x AKIAABCDEFGHIJKLMNOP xoxb-123456789012-abc");
ok("GitHub token 打码", len(str_match("ghp_abcdefghijklmnop", leaky)) == 0);
ok("AWS key 打码", len(str_match("AKIAABCDEFGHIJKLMNOP", leaky)) == 0);
ok("Slack token 打码", len(str_match("xoxb-123456789012", leaky)) == 0);

// ---- 云环境动作审计 ----
print("store: env actions");
store.put_env_action({ host: "1.2.3.4", project_id: "p1", target: "t1", action: "helm-history",
  status: "submitted", actor: "human_admin", job_id: "job-1" });
store.put_env_action({ host: "5.6.7.8", project_id: "p2", target: "t2", action: "docker-logs",
  status: "submitted", actor: "agent_operator", job_id: "job-2" });
let ea = store.list_env_actions("1.2.3.4", 0, 0, 10);
let eas = get(ea, "actions", []);
ok("审计按 host 过滤", len(eas) == 1);
ok("审计按时间下界过滤", len(get(store.list_env_actions("1.2.3.4", 1, 0, 10), "actions", [])) == 1);
ok("审计按时间上界过滤", len(get(store.list_env_actions("1.2.3.4", 0, 1, 10), "actions", [])) == 0);
let first = get(eas, 0, {});
ok("审计保留动作与 job", str(get(first, "action", "")) == "helm-history"
  and str(get(first, "job_id", "")) == "job-1");
ok("审计全局列表", len(get(store.list_env_actions("", 0, 0, 10), "actions", [])) >= 2);
let fin = store.finish_env_action("job-1", "success", 0);
ok("审计回写成功", get(fin, "ok", false) and not get(fin, "unchanged", false));
let ea2 = get(get(store.list_env_actions("1.2.3.4", 0, 0, 10), "actions", []), 0, {});
ok("审计状态变成功", str(get(ea2, "status", "")) == "success" and int(get(ea2, "exit", -1)) == 0);
let fin2 = store.finish_env_action("job-1", "failed", 1);
ok("终态不覆盖", get(fin2, "ok", false) and get(fin2, "unchanged", false)
  and str(get(get(get(store.list_env_actions("1.2.3.4", 0, 0, 10), "actions", []), 0, {}), "status", "")) == "success");

// ---- 授权判定审计 ----
print("store: access events");
store.put_access_event({ user: "audit-a", role: "agent_operator", resource: "project-admin",
  action: "update", label: "修改项目配置", allowed: false, reason: "需要 human_admin", auth: "identity" });
store.put_access_event({ user: "audit-b", role: "human_admin", resource: "project-admin",
  action: "update", label: "修改项目配置", allowed: true, reason: "", auth: "identity" });
let ae = store.list_access_events("audit-a", "", 0, 0, 10);
let aes = get(ae, "events", []);
ok("授权审计按 user 过滤", len(aes) == 1);
ok("授权审计按时间下界过滤", len(get(store.list_access_events("audit-a", "", 1, 0, 10), "events", [])) == 1);
ok("授权审计按时间上界过滤", len(get(store.list_access_events("audit-a", "", 0, 1, 10), "events", [])) == 0);
let ev = get(aes, 0, {});
ok("授权审计保留资源动作", str(get(ev, "resource", "")) == "project-admin"
  and str(get(ev, "action", "")) == "update");
ok("授权审计保留拒绝原因", not get(ev, "allowed", true)
  and len(str(get(ev, "reason", ""))) > 0 and str(get(ev, "auth", "")) == "identity");
let ae2 = store.list_access_events("", "project-admin", 0, 0, 10);
ok("授权审计按 resource 过滤", len(get(ae2, "events", [])) >= 2);
let ap = get(get(store.list_access_events("audit-b", "", 0, 0, 10), "events", []), 0, {});
ok("授权审计保留放行", get(ap, "allowed", false) and len(str(get(ap, "created_at", ""))) > 0);

// 保留策略：每次写入后裁到 keep 条，测试用 105 条压过 100 的下限。
print("store: access retention");
let i = 0;
while (i < 105) {
  store.put_access_event({ user: "audit-prune", role: "agent_operator", resource: "test",
    action: "write", label: "保留策略", allowed: true, reason: "", auth: "identity" });
  i = i + 1;
}
let all = get(store.list_access_events("", "", 0, 0, 500), "events", []);
ok("审计保留上限生效", len(all) == 100);

// 云环境终态审计同样有上限，但 submitted 不能被裁掉。
print("store: env retention");
store.put_env_action({ host: "9.9.9.9", project_id: "p9", target: "t9", action: "docker-logs",
  status: "submitted", actor: "human_admin", job_id: "job-keep" });
let k = 0;
while (k < 105) {
  store.put_env_action({ host: "9.9.9.9", project_id: "p9", target: "t9", action: "docker-logs",
    status: "success", actor: "human_admin", job_id: "job-old-" + str(k) });
  k = k + 1;
}
let eall = get(store.list_env_actions("", 0, 0, 500), "actions", []);
let submitted = 0;
let x = 0;
while (x < len(eall)) {
  if (str(get(eall[x], "status", "")) == "submitted") { submitted = submitted + 1; }
  x = x + 1;
}
ok("环境审计总条数不超过上限", len(eall) <= 100);
ok("submitted 记录不被裁剪", submitted >= 2);

// ---- 清空 ----
print("store: clear");
// 上面的保留策略留下 3 条、恢复回来 1 条，清空必须把它们全删掉。
ok("清空运行", int(store.clear_runs()) == 4);
ok("运行已空", int(get(store.list_runs("", 10, 0), "total", 0)) == 0);
// 1 条基础部署 + 4 条回滚用例，清空要一次全删。
ok("清空部署", int(store.clear_deployments()) == 5);
ok("删除项目", int(store.delete_project("proj-t1")) == 1);
ok("项目已删", store.get_project("proj-t1") == null);

// ---- 级联删除 ----
print("store: cascade");
store.put_project({ id: "proj-del", name: "del", description: "", repository: "", branch: "main" }, true);
store.put_run({ id: "run-del", project_id: "proj-del", project_name: "del", trigger: "manual",
  status: "success", image_ref: "del:1", created_ts: now() });
store.write_log("run-del", "some log\n");
store.put_deployment({ id: "dep-del", project_id: "proj-del", project_name: "del", method: "ssh", status: "success" });
store.put_kb({ id: "kb-del", project_id: "proj-del", project_name: "del", stage: "build", signature: "x", error_keyword: "y" });
store.put_release({ id: "rel-del", project_id: "proj-del", project_name: "del", status: "failed", stages: [] });
let cas = store.delete_project_cascade("proj-del");
ok("级联删掉项目", int(get(cas, "project", 0)) == 1 and store.get_project("proj-del") == null);
ok("级联删掉运行", int(get(cas, "runs", 0)) == 1 and int(get(store.list_runs("proj-del", 10, 0), "total", 0)) == 0);
ok("级联删掉部署", int(get(cas, "deployments", 0)) == 1);
ok("级联删掉知识库", int(get(cas, "kb", 0)) == 1);
ok("级联删掉发布链路", int(get(cas, "releases", 0)) == 1 and store.get_release("rel-del") == null);
ok("级联清空运行日志", len(read_file(store.run_log_path("run-del"))) == 0);

print("");
let nc = int(get(st, "checks", 0));
let nf = int(get(st, "fails", 0));
if (nf == 0) { print("store_test: " + str(nc) + " checks passed"); } else { print("store_test: " + str(nf) + " of " + str(nc) + " FAILED"); }
