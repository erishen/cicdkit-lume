# cicdkit-lume 运行时环境变量（示例；复制为 .env 后自行导出，或直接 export）
#
# 注意：Lume 的 env() 对含 TOKEN / SECRET / API_KEY / PASSWORD / CREDENTIAL
# 的变量名返回 null（安全屏蔽），所以上游 Token 用 CICD_AUTH 这个名字，
# 不要写成 CICD_TOKEN —— 那个名字在 .lume 里永远读到 null。

# 上游 cicdkit 地址
CICD_BASE=http://127.0.0.1:8080

# 上游 API Token（二选一）
# 方式一：直接放环境变量
# CICD_AUTH=change-me
# 方式二（推荐）：token 放文件，进程环境里不留明文
# printf '%s' 'change-me' > .data/upstream.token
# CICD_AUTH_FILE=.data/upstream.token

# 发布审批闸门：off | approve | execute
CICD_DEPLOY_APPROVAL=off

# 监听
LUME_BIND=127.0.0.1
LUME_PORT=8096

# 对外暴露时启用 Basic Auth（htpasswd 文件格式：user:bcrypt/apr1 hash）
# HTPASSWD_FILE=.data/htpasswd
