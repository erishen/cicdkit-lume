# cicdkit-lume 运行时环境变量（示例；复制为 .env 后自行导出，或直接 export）
#
# 注意：Lume 的 env() 对含 TOKEN / SECRET / API_KEY / PASSWORD / CREDENTIAL
# 的变量名返回 null（安全屏蔽）。所以 runner 的令牌叫 RUNNER_AUTH，
# 不要写成 RUNNER_TOKEN —— 那个名字在 .lume 里永远读到 null。

# ---------- 控制面 ----------
LUME_BIND=127.0.0.1
LUME_PORT=8096
# 数据目录：store.db（SQLite）+ logs/（运行日志）
LUME_DATA=./.data

# 项目根：build.context / dockerfile / manifest 的允许目录（绝对路径前缀校验）
CICD_WORK_DIR=/home/ci/workspace
# 目录浏览（「浏览目录」按钮）允许的根，冒号分隔
CICD_FS_ROOTS=/home/ci/workspace

# 外部 CI 触发流水线的共享密钥；不设则 /api/webhook/:id 返回 503
# CICD_HOOK_KEY=

# 腾讯云 k3s SSH 隧道目标（示例占位，实际值放 .env，不要提交）
# TENCENT_K3S_SSH_HOST=root@your-k3s-host

# 发布审批闸门：off | approve | execute
CICD_DEPLOY_APPROVAL=off

# ---------- Basic Auth ----------
# 这里是唯一事实来源：make auth 读取这两个值，生成 htpasswd / Prometheus 口令文件。
# 改了之后重跑 `make docker`（或 `make auth` 后重建两个栈）即可生效。
CICDKIT_BASIC_USER=cicd
CICDKIT_BASIC_PASS=change-me-to-a-random-string
# 身份绑定：Basic Auth 用户 → accounts.json 角色；账号表读不到/用户未登记即拒绝。
# make auth 首次生成 ~/.config/cicdkit-lume/accounts.json，之后按人加角色。
CICD_ACCOUNTS_ENFORCE=1
# CICD_ACCOUNTS_FILE=/auth/accounts.json
# CICD_ACCESS_RESOURCES_FILE=/auth/resources.json
# CICD_AUDIT_KEEP=5000
# CICD_ENV_AUDIT_KEEP=5000
# CICD_A2A_TASK_KEEP=1000
# 顶栏默认角色：agent_operator | human_admin；单人用 cicd 登录时通常设 human_admin
CICD_DEFAULT_ROLE=agent_operator

# 运行历史 / 归档保留条数（活跃运行与归档各算一套）
# CICD_RUN_KEEP=300
# CICD_ARCHIVE_KEEP=1000

# make backup 的保留份数（默认 14）
# BACKUP_KEEP=14

# ---------- runner ----------
# 控制面 → runner 的地址
RUNNER_BASE=http://127.0.0.1:8899
# runner 令牌（二选一：环境变量或文件）
# 必填；make docker 会自动生成 .data/runner.token，手跑请自己填随机值
RUNNER_AUTH=
# RUNNER_AUTH_FILE=./.data/runner.token

# runner 进程侧（宿主机直接跑 make runner 时生效）
RUNNER_BIND=127.0.0.1:8899
RUNNER_LOG_DIR=./.data/logs
RUNNER_ALLOW=docker,kubectl,helm,ssh,scp,git
RUNNER_MAX_JOBS=4

# ---------- 部署兜底值（项目配置里留空时使用）----------
# kubectl 系方法没有 kubeconfig 时用这个
# kubectl/helm/local-k3s 部署的兜底 kubeconfig（迁移后可指向 ../cicdkit/data-docker/kubeconfig-cicd）
CICD_DEFAULT_KUBECONFIG=
# SSH 部署
CICD_SSH_USER=
CICD_SSH_PORT=
CICD_SSH_KEY_PATH=
CICD_SSH_CONTAINER=
CICD_SSH_CONTAINER_PORT=
CICD_SSH_PROBE_PORT=
CICD_SSH_RUN_ARGS=
CICD_SSH_COMMAND=

# ---------- 可选 ----------
# 一次性把旧 cicdkit 的数据文件搬进来（只在不空的库上生效一次）
# CICD_LEGACY_STORE=/path/to/cicdkit/data-docker/store.json
# Basic Auth：compose 默认启用，凭据由 `make auth` 生成到 ~/.config/cicdkit-lume
# （htpasswd 为 bcrypt，prometheus.pass 为同口令明文，只读挂给 Prometheus）
# HTPASSWD_FILE=/auth/htpasswd
