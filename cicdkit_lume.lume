};

post "/api/projects/:id/:action", (req) => {
  let id = str(get(req.params, "id", ""));
  let action = str(get(req.params, "action", ""));
  // validate / probe 只读；build / pipeline 会真正投递 job。不能因为共用
  // :action 路由就跳过闸门。
  let resource = "project-run";
  let act = "build";
  if (action == "validate" or action == "probe") { resource = "project-inspect"; act = "read"; }
  let gate = abac(req, resource, act, "项目动作", "");
  if (not get(gate, "allowed", false)) { return denied(gate, "项目动作"); }
  return api.project_action(id, action, body_of(req));
};

