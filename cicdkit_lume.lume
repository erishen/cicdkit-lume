// cicdkit_lume.lume — cicdkit 的替代实现：Lume 单进程控制面 + 薄 runner
//
// 形态：本进程 = 静态站（www/）+ SPA 回退 + 同源 JSON API + 状态存储（SQLite）。
// 代码执行发生在内网 runner（runner/main.go）里：本进程只把项目配置翻译成
// argv 计划并投递 job，日志按字节偏移从共享目录增量读取。
// cicdkit 本体（13k 行 Go 服务 + 232MB 镜像）不再需要运行。
//
//   GET  /api/health            本服务 + runner + 存储健康
//   GET  /api/meta              runner 地址、审批闸门策略、LLM 状态
//   GET  /api/version           版本信息（前端顶栏）
//   GET  /api/overview          首屏聚合
//   GET  /api/projects          项目列表（?q= &limit= &offset=）
//   POST /api/projects          新建项目（需 ?role=human_admin）
//   POST /api/projects/scan     扫描工作目录里的候选项目（需 ?role=human_admin）
//   GET  /api/projects/:id      项目详情（机密字段掩码）
//   PUT  /api/projects/:id      保存项目配置（需 ?role=human_admin）
//   DEL  /api/projects/:id      删除项目（需 ?role=human_admin）
//   POST /api/projects/:id/deploy      发布（受审批闸门保护）
//   POST /api/projects/:id/:action     build / pipeline / validate / probe
//   GET  /api/projects/:id/targets/:target/deploy  指定目标发布
//   GET  /api/runs              运行列表；DELETE /api/runs 清空
//   GET  /api/runs/:id          运行详情
//   GET  /api/runs/:id/log      增量日志尾（?from= 字节偏移，顺带同步状态）
//   POST /api/runs/:id/cancel   取消运行
//   POST /api/runs/:id/diagnose        AI 诊断失败运行
//   POST /api/runs/:id/diagnosis/adopt 采纳 / 不采纳（采纳写入知识库）
//   GET  /api/deployments       部署历史；DELETE 清空（需 ?role=human_admin）
//   GET  /api/kb                知识库；POST 新增（需 human_admin）；DELETE 删除
//   GET  /api/config/llm        LLM 配置（掩码）；PUT 保存；POST /test 测连通
//   GET  /api/config/ssh-defaults      CICD_SSH_* 兜底值（掩码，供表单预填）
//   GET  /api/fs/roots          可浏览根目录（需 human_admin）
//   GET  /api/fs/list           列目录（?dir=，需 human_admin）
//
// 环境变量：
//   LUME_DATA              数据目录，默认 ./.data（store.db + logs/）
//   RUNNER_BASE            runner 地址，默认 http://127.0.0.1:8899
//   RUNNER_AUTH / RUNNER_AUTH_FILE   runner 的 X-Runner-Token
//                          不能叫 RUNNER_TOKEN —— env() 对含 TOKEN 的名字返回 null
//   CICD_WORK_DIR          项目根目录（build.context 相对它解析），默认 .
//   CICD_DEPLOY_APPROVAL   off | approve | execute（默认 off）
//   CICD_FS_ROOTS          允许浏览的目录，冒号分隔，默认 CICD_WORK_DIR
//   LUME_BIND / LUME_PORT  默认 127.0.0.1:8096
//   HTPASSWD_FILE          可选 Basic Auth

let lc_bind = env("LUME_BIND");
if (lc_bind == null) { lc_bind = "127.0.0.1"; }
let lc_port = env("LUME_PORT");
if (lc_port == null) { lc_port = "8096"; }

server {
  port = int(lc_port);
  // 8 = agent-httpd 慢路径 worker 池容量。每个 /api/* 可能是一次 runner
  // 往返或一次模型调用（诊断预算 150s），池太小时两个慢请求就能堵死整层 API。
  workers = 8;
  bind = str(lc_bind);
  docroot = "./www";
  spa = true;                       // history 路由：GET + 静态 404 → www/index.html
  htpasswd = env("HTPASSWD_FILE");  // 本地留空 = 无认证；对外部署注入即开 Basic Auth
};

import "src/app_api.lume" as api;
import "src/store.lume" as store;
import "src/guard.lume" as guard;
import "src/a2a.lume" as a2a;

// ---------- 启动期：把库建好，必要时把 cicdkit 的历史数据搬进来 ----------
// 只搬一次：import_legacy() 用 empty() 判空，库里已有内容就跳过。
store.init();
a2a.init();
let lc_imp = store.import_legacy();
if (get(lc_imp, "imported", false)) {
  print("legacy import: " + stringify(lc_imp));
}

func qint(req, key, def) {
  let qp = get(req, "query_params", null);
  if (qp == null) { return def; }
  let v = get(qp, key, null);
  if (v == null) { return def; }
  let n = int(v);
  if (n <= 0) { return def; }
  return n;
}

func qstr(req, key, def) {
  let qp = get(req, "query_params", null);
  if (qp == null) { return def; }
  let v = get(qp, key, null);
  if (v == null) { return def; }
  return str(v);
}

func body_of(req) {
  let b = get(req, "body", null);
  if (b == null) { return "{}"; }
  let s = str(b);
  if (len(s) == 0) { return "{}"; }
  return s;
}

func denied(gate, label) {
  return {
    status: 403,
    body: { ok: false, error: str(get(gate, "reason", label + "被闸门拒绝")), approval: gate },
  };
}

// ---------- 健康 / 元信息 ----------

get "/api/health", (req) => {
  return { status: 200, body: api.health() };
};

get "/api/meta", (req) => {
  let m = api.meta();
  put(m, "approval", guard.policy());
  return { status: 200, body: m };
};

get "/api/version", (req) => {
  return { status: 200, body: { ok: true, service: "cicdkit-lume", version: "native", mode: "lume-control-plane" } };
};

get "/api/overview", (req) => {
  return { status: 200, body: api.overview() };
};

// ---------- A2A 标准面 + peer 签名面 ----------
// 六个端点与上游 cicdkit/internal/a2a 同形：card 公开发现、/a2a 走 JSON-RPC、
// /peer/* 走 HMAC 签名（未配 CICDKIT_PEER_SHARED/ROOT 时整面 fail-closed 关闭）。
// 能力全只读，任何写入（发布/删除/SSH）都不在这两面里。
get "/.well-known/agent-card.json", (req) => {
  return { status: 200, body: a2a.card() };
};

// 上游这里是 302 到 "/"，但 Lume 的路由信封只能改 status/type/cache_control，
// 发不出 Location 头 —— 与其给一个没有 Location 的 302（客户端会当成坏响应），
// 不如明确回 405 并说清怎么用。
get "/a2a", (req) => {
  return {
    status: 405,
    body: {
      ok: false,
      error: "GET /a2a 不支持：JSON-RPC 走 POST /a2a，只读发现走 GET /.well-known/agent-card.json",
    },
  };
};

post "/a2a", (req) => { return a2a.rpc(req); };

get "/peer/health", (req) => { return a2a.peer_health(req); };
get "/peer/tools", (req) => { return a2a.peer_tools(req); };
post "/peer/invoke", (req) => { return a2a.peer_invoke(req); };
post "/peer/relay", (req) => { return a2a.peer_relay(req); };

// ---------- webhook（外部 CI 触发，不受角色闸门，用自己的 key 校验）----------
post "/api/webhook/:id", (req) => {
  return api.webhook(str(get(req.params, "id", "")), body_of(req), qstr(req, "secret", ""));
};

// ---------- 项目 ----------

get "/api/projects", (req) => {
  let page = api.project_list(qstr(req, "q", ""), qint(req, "limit", 200), qint(req, "offset", 0));
  return { status: 200, body: page };
};

post "/api/projects", (req) => {
  let gate = guard.role_allowed(req, "human_admin", "新建项目");
  if (not get(gate, "allowed", false)) { return denied(gate, "新建项目"); }
  return api.project_create(body_of(req));
};

// 放在 /api/projects/:id 之前：静态段优先匹配（路由按注册顺序，先命中先返回）。
post "/api/projects/scan", (req) => {
  let gate = guard.role_allowed(req, "human_admin", "扫描工作目录");
  if (not get(gate, "allowed", false)) { return denied(gate, "扫描工作目录"); }
  return api.project_scan(qstr(req, "dir", ""));
};

// 发布单独一条：唯一受审批闸门保护的动作（构建可重跑，发布不可逆）。
post "/api/projects/:id/deploy", (req) => {
  let id = str(get(req.params, "id", ""));
  let gate = guard.deploy_allowed(req);
  if (not get(gate, "allowed", false)) {
    return { status: 403, body: { ok: false, error: str(get(gate, "reason", "发布被审批闸门拒绝")), approval: gate } };
  }
  return api.project_deploy(id, body_of(req));
};

// 指定发布目标：POST /api/projects/:id/deploy?target=xxx 已经覆盖绝大多数用法，
// 这里保留一个 target 走 path 的形状，方便前端按目标列按钮。
post "/api/projects/:id/targets/:target/deploy", (req) => {
  let id = str(get(req.params, "id", ""));
  let target = str(get(req.params, "target", ""));
  let gate = guard.deploy_allowed(req);
  if (not get(gate, "allowed", false)) {
    return { status: 403, body: { ok: false, error: str(get(gate, "reason", "发布被审批闸门拒绝")), approval: gate } };
  }
  return api.project_deploy(id, "{\"target\":\"" + target + "\"}");
};

// 发布版本列表（只读）：给回滚下拉用。
get "/api/projects/:id/deploy-versions", (req) => {
  return api.deploy_versions(str(get(req.params, "id", "")), qstr(req, "target", ""));
};

// 回滚上一版：和 deploy 一样属于"对外发布"，所以走同一个审批闸门。
// body 里可以带 image_ref / target，指定任意历史版本；不带就是"上一版"。
post "/api/projects/:id/rollback", (req) => {
  let id = str(get(req.params, "id", ""));
  let gate = guard.deploy_allowed(req);
  if (not get(gate, "allowed", false)) {
    return { status: 403, body: { ok: false, error: str(get(gate, "reason", "发布被审批闸门拒绝")), approval: gate } };
  }
  return api.project_rollback(id, body_of(req));
};

// 脚手架生成：必须在 :action 之前注册，否则会被当成未知动作。
post "/api/projects/:id/generate", (req) => {
  let id = str(get(req.params, "id", ""));
  let gate = guard.role_allowed(req, "human_admin", "生成项目脚手架");
  if (not get(gate, "allowed", false)) { return denied(gate, "生成项目脚手架"); }
  return api.project_generate(id, qstr(req, "apply", "") == "1");
};

post "/api/projects/:id/:action", (req) => {
  let id = str(get(req.params, "id", ""));
  let action = str(get(req.params, "action", ""));
  return api.project_action(id, action, body_of(req));
};

get "/api/projects/:id", (req) => {
  return api.project_get(str(get(req.params, "id", "")));
};

put "/api/projects/:id", (req) => {
  let gate = guard.role_allowed(req, "human_admin", "修改项目配置");
  if (not get(gate, "allowed", false)) { return denied(gate, "项目配置"); }
  return api.project_put(str(get(req.params, "id", "")), body_of(req));
};

delete "/api/projects/:id", (req) => {
  let gate = guard.role_allowed(req, "human_admin", "删除项目");
  if (not get(gate, "allowed", false)) { return denied(gate, "删除项目"); }
  return api.project_delete(str(get(req.params, "id", "")));
};

// ---------- 服务器目录浏览（编辑 build.context 用）----------
// 只读，但会暴露目录名，所以与「保存项目配置」同门禁。
get "/api/fs/roots", (req) => {
  let gate = guard.role_allowed(req, "human_admin", "浏览服务器目录");
  if (not get(gate, "allowed", false)) { return denied(gate, "目录浏览"); }
  return { status: 200, body: api.fs_roots() };
};

get "/api/fs/list", (req) => {
  let gate = guard.role_allowed(req, "human_admin", "浏览服务器目录");
  if (not get(gate, "allowed", false)) { return denied(gate, "目录浏览"); }
  return api.fs_list(qstr(req, "dir", ""));
};

// ---------- 运行 ----------

get "/api/runs", (req) => {
  return { status: 200, body: api.run_list(qstr(req, "project_id", ""), qint(req, "limit", 100), qint(req, "offset", 0)) };
};

delete "/api/runs", (req) => {
  let gate = guard.role_allowed(req, "human_admin", "清空运行记录");
  if (not get(gate, "allowed", false)) { return denied(gate, "清空运行记录"); }
  return api.run_clear();
};

// 归档列表必须排在 /api/runs/:id 之前，否则 "archive" 会被当成一个 run id。
get "/api/runs/archive", (req) => {
  return api.run_archive(qint(req, "limit", 200));
};

post "/api/runs/:id/restore", (req) => {
  let gate = guard.role_allowed(req, "human_admin", "恢复归档运行");
  if (not get(gate, "allowed", false)) { return denied(gate, "恢复归档运行"); }
  return api.run_restore(str(get(req.params, "id", "")));
};

// 日志尾放在 :id 之前也无所谓（路径段数不同），但按具体优先写更清楚。
get "/api/runs/:id/log", (req) => {
  return api.run_log(str(get(req.params, "id", "")), qint(req, "from", 0));
};

post "/api/runs/:id/cancel", (req) => {
  return api.run_cancel(str(get(req.params, "id", "")));
};

post "/api/runs/:id/diagnose", (req) => {
  return api.run_diagnose(str(get(req.params, "id", "")));
};

post "/api/runs/:id/diagnosis/adopt", (req) => {
  return api.run_adopt(str(get(req.params, "id", "")), body_of(req));
};

get "/api/runs/:id", (req) => {
  return api.run_get(str(get(req.params, "id", "")));
};

// ---------- 部署历史 ----------

get "/api/deployments", (req) => {
  return { status: 200, body: api.deployment_list(qstr(req, "project_id", ""), qint(req, "limit", 100), qint(req, "offset", 0)) };
};

delete "/api/deployments", (req) => {
  let gate = guard.role_allowed(req, "human_admin", "清空部署历史");
  if (not get(gate, "allowed", false)) { return denied(gate, "清空部署历史"); }
  return api.deployment_clear();
};

// ---------- 知识库 ----------

get "/api/kb", (req) => {
  return { status: 200, body: api.kb_list(qstr(req, "q", ""), qint(req, "limit", 200)) };
};

post "/api/kb", (req) => {
  let gate = guard.role_allowed(req, "human_admin", "写入知识库");
  if (not get(gate, "allowed", false)) { return denied(gate, "写入知识库"); }
  return api.kb_add(body_of(req));
};

delete "/api/kb/:id", (req) => {
  return api.kb_delete(str(get(req.params, "id", "")));
};

// ---------- LLM 配置 ----------
// 读配置是掩码的，可以公开；写/测能改 BaseURL 并使用已存密钥（等于让服务端把
// 密钥发到任意地址），强制 human_admin。

get "/api/config/llm", (req) => {
  return { status: 200, body: api.llm_get() };
};

put "/api/config/llm", (req) => {
  let gate = guard.role_allowed(req, "human_admin", "修改 LLM 配置");
  if (not get(gate, "allowed", false)) { return denied(gate, "LLM 配置"); }
  return api.llm_put(body_of(req));
};

post "/api/config/llm/test", (req) => {
  let gate = guard.role_allowed(req, "human_admin", "测试 LLM 连接");
  if (not get(gate, "allowed", false)) { return denied(gate, "LLM 配置"); }
  return api.llm_test(body_of(req));
};

// 表单预填用：只给「兜底值是否存在」，不把私钥路径回传给浏览器以外的用途。
get "/api/config/ssh-defaults", (req) => {
  return { status: 200, body: api.ssh_defaults() };
};

run();  // 注册窗口关闭，开始伺服
