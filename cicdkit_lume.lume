// cicdkit_lume.lume — cicdkit 的替代实现：Lume 单进程控制面 + 薄 runner
//
// 形态：本进程 = 静态站（www/）+ SPA 回退 + 同源 JSON API + 状态存储（SQLite）。
// 代码执行发生在内网 runner（runner/main.go）里：本进程只把项目配置翻译成
// argv 计划并投递 job，日志按字节偏移从共享目录增量读取。
// cicdkit 本体（13k 行 Go 服务 + 232MB 镜像）不再需要运行。
//
//   GET  /metrics/cicdkit      Prometheus 文本指标（不鉴权；/metrics 被框架占用）
//   GET  /api/health            本服务 + runner + 存储健康
//   GET  /api/meta              runner 地址、审批闸门策略、LLM 状态
//   GET  /api/version           版本信息（前端顶栏）
//   GET  /api/overview          首屏聚合
//   POST /api/agent/query       Agent/Text2SQL：自然语言 → 受限只读 SELECT
//   GET  /api/projects          项目列表（?q= &limit= &offset=）
//   POST /api/projects          新建项目（需 ?role=human_admin）
//   POST /api/projects/scan     扫描工作目录里的候选项目（需 ?role=human_admin）
//   GET  /api/projects/:id      项目详情（机密字段掩码）
//   PUT  /api/projects/:id      保存项目配置（需 ?role=human_admin）
//   DEL  /api/projects/:id      删除项目（需 ?role=human_admin）
//   POST /api/projects/:id/deploy      发布（受审批闸门保护）
//   POST /api/projects/:id/:action     build / pipeline / validate / probe
//   GET  /api/projects/:id/generate    脚手架方案预览（POST 同路径 = 落盘）
//   GET  /api/projects/:id/visits      线上访客统计（代理到应用自己的 /api/visits）
//   GET  /api/projects/:id/targets/:target/deploy  指定目标发布
//   GET  /api/runs              运行列表；DELETE /api/runs 清空
//   GET  /api/runs/:id          运行详情
//   GET  /api/runs/:id/log      增量日志尾（?from= 字节偏移，顺带同步状态）
//   POST /api/runs/:id/cancel   取消运行
//   POST /api/runs/:id/diagnose        AI 诊断失败运行
//   POST /api/runs/:id/diagnosis/adopt 采纳 / 不采纳（采纳写入知识库）
//   GET  /api/deployments       部署历史；DELETE 清空（需 ?role=human_admin）
//   GET  /api/environments      云环境聚合（按 ssh_host，只读）
//   POST /api/environments/:host/snapshot  固定只读主机快照（需任意合法角色）
//   GET  /api/environments/snapshot/:job    快照 job 状态与日志
//   POST /api/environments/:host/actions    受控动作：helm-history / docker-logs 需任意角色；rollout-restart / docker-restart 需 human_admin
//   GET  /api/environments/actions          云环境动作审计（?host= &limit=）
//   GET  /api/kb                知识库；POST 新增（需 human_admin）；DELETE 删除
//   GET  /api/config/llm        LLM 配置（掩码）；PUT 保存；POST /test 测连通
//   GET  /api/config/ssh-defaults      CICD_SSH_* 兜底值（掩码，供表单预填）
//   GET  /api/fs/roots          可浏览根目录（需 human_admin）
//   GET  /api/fs/list           列目录（?dir=，需 human_admin）
//
// 环境变量：
//   LUME_DATA              数据目录，默认 ./.data（store.db + logs/）
//   RUNNER_BASE            runner 地址，默认 http://127.0.0.1:8899
//   RUNNER_AUTH / RUNNER_AUTH_FILE   runner 的 X-Runner-Token
//                          不能叫 RUNNER_TOKEN —— env() 对含 TOKEN 的名字返回 null
//   CICD_WORK_DIR          项目根目录（build.context 相对它解析），默认 .
//   CICD_DEPLOY_APPROVAL   off | approve | execute（默认 off）
//   CICD_FS_ROOTS          允许浏览的目录，冒号分隔，默认 CICD_WORK_DIR
//   LUME_BIND / LUME_PORT  默认 127.0.0.1:8096
//   HTPASSWD_FILE          可选 Basic Auth

let lc_bind = env("LUME_BIND");
if (lc_bind == null) { lc_bind = "127.0.0.1"; }
let lc_port = env("LUME_PORT");
if (lc_port == null) { lc_port = "8096"; }

server {
  port = int(lc_port);
  // 8 = agent-httpd 慢路径 worker 池容量。每个 /api/* 可能是一次 runner
  // 往返或一次模型调用（诊断预算 150s），池太小时两个慢请求就能堵死整层 API。
  workers = 8;
  bind = str(lc_bind);
  docroot = "./www";
  spa = true;                       // history 路由：GET + 静态 404 → www/index.html
  htpasswd = env("HTPASSWD_FILE");  // 本地留空 = 无认证；对外部署注入即开 Basic Auth
};

import "src/app_api.lume" as api;
import "src/store.lume" as store;
import "src/guard.lume" as guard;
import "src/access.lume" as access;
import "src/a2a.lume" as a2a;
import "src/agent.lume" as agent;
import "src/metrics.lume" as metrics;

// ---------- 启动期：把库建好，必要时把 cicdkit 的历史数据搬进来 ----------
// 只搬一次：import_legacy() 用 empty() 判空，库里已有内容就跳过。
store.init();
a2a.init();
agent.init();
let lc_imp = store.import_legacy();
if (get(lc_imp, "imported", false)) {
  print("legacy import: " + stringify(lc_imp));
}

func qint(req, key, def) {
  let qp = get(req, "query_params", null);
  if (qp == null) { return def; }
  let v = get(qp, key, null);
  if (v == null) { return def; }
  let n = int(v);
  if (n <= 0) { return def; }
  return n;
}

// 列表接口的 limit 上限：不设上限时 ?limit=1000000 会原样拼进 SQL，
// 把结果全查出来再序列化，一次请求就能把 worker 和内存顶满。
func qlimit(req, key, def) {
  let n = qint(req, key, def);
  if (n > 500) { return 500; }
  return n;
}

func qstr(req, key, def) {
  let qp = get(req, "query_params", null);
  if (qp == null) { return def; }
  let v = get(qp, key, null);
  if (v == null) { return def; }
  return str(v);
}

func body_of(req) {
  let b = get(req, "body", null);
  if (b == null) { return "{}"; }
  let s = str(b);
  if (len(s) == 0) { return "{}"; }
  return s;
}

// 发布链路里记录发起人；旧 ?role= 模式没有 Basic Auth 用户时记 local。
func actor_of(req) {
  let u = get(req, "user", null);
  if (u != null and len(trim(str(u))) > 0) { return str(u); }
  return "local";
}


// 所有闸门判定都留一条授权审计：谁（Basic Auth 用户）、用什么角色、
// 对哪个资源/动作、放行还是拒绝。写失败不影响主流程，审计不能把业务卡死。
func audit_access(req, gate, resource, action, label) {
  let g = gate;
  if (g == null) { g = {}; }
  let who = str(get(g, "user", ""));
  let how = str(get(g, "auth", ""));
  if (len(how) == 0 and len(who) > 0) { how = "identity"; }
  let e = {
    user: who,
    role: str(get(g, "role", "")),
    resource: str(resource),
    action: str(action),
    label: str(label),
    allowed: bool(get(g, "allowed", false)),
    reason: str(get(g, "reason", "")),
    auth: how,
  };
  store.put_access_event(e);
}

// 身份绑定开启时按资源表判定；没开启才回退旧的 guard（resource 表未登记即拒绝）。
// fallback_role 为空表示旧模式只要求“任意合法角色”，否则要求指定角色。
func abac(req, resource, action, label, fallback_role) {
  let gate = access.decide(req, resource, action);
  if (not get(gate, "enabled", false)) {
    if (len(fallback_role) > 0) { gate = guard.role_allowed(req, fallback_role, label); }
    else { gate = guard.role_any(req, label); }
  }
  audit_access(req, gate, resource, action, label);
  return gate;
}

// 只读接口的身份闸门：开启身份绑定后按资源表 deny-by-default；旧 ?role= 模式
// 保持原来的“Basic Auth 已登录即可读”，避免迁移期把只读页全部锁死。
// 返回 null 表示放行，否则返回 403 响应。
func read_gate(req, resource, action, label) {
  let gate = access.decide(req, resource, action);
  if (not get(gate, "enabled", false)) { return null; }
  audit_access(req, gate, resource, action, label);
  if (not get(gate, "allowed", false)) { return denied(gate, label); }
  return null;
}

// 高频轮询接口（运行日志、云环境快照）只审计拒绝，不记每次放行：
// 运行中的日志 1.5s 拉一次，若每次也写 access_events，会把保留窗口冲掉。
func read_gate_quiet(req, resource, action, label) {
  let gate = access.decide(req, resource, action);
  if (not get(gate, "enabled", false)) { return null; }
  if (not get(gate, "allowed", false)) {
    audit_access(req, gate, resource, action, label);
    return denied(gate, label);
  }
  return null;
}

func denied(gate, label) {
  return {
    status: 403,
    body: { ok: false, error: str(get(gate, "reason", label + "被闸门拒绝")), approval: gate },
  };
}

// ---------- 健康 / 元信息 ----------

// Prometheus 抓取点。注意路径不是 /metrics：lume 的 agent-httpd 在自定义
// 路由之前就把 /metrics 吃掉了（返回框架自己的 agenthttpd_* 计数），这是框架
// 的硬编码行为，脚本层改不了。所以控制面指标挂在 /metrics/cicdkit 上
//（同时给一个 /api/metrics 别名），Prometheus 的 scrape path 要相应指过来。
// 与上游一样不鉴权，只暴露有限枚举标签的计数。
get "/metrics/cicdkit", (req) => {
  return metrics.text();
};

get "/api/metrics", (req) => {
  return metrics.text();
};

get "/api/health", (req) => {
  return { status: 200, body: api.health() };
};

get "/api/meta", (req) => {
  let m = api.meta();
  put(m, "approval", guard.policy(req));
  return { status: 200, body: m };
};

get "/api/version", (req) => {
  return { status: 200, body: { ok: true, service: "cicdkit-lume", version: "native", mode: "lume-control-plane" } };
};

get "/api/overview", (req) => {
  let blocked = read_gate(req, "project-read", "read", "总览");
  if (blocked != null) { return blocked; }
  return { status: 200, body: api.overview() };
};

// ---------- Agent / Text2SQL（只读）----------
// 自然语言 → 受限 SELECT → 查三张扁平表；不写库、不触发发布。
post "/api/agent/query", (req) => {
  let gate = abac(req, "agent-query", "read", "Agent 查询", "");
  if (not get(gate, "allowed", false)) { return denied(gate, "Agent 查询"); }
  return agent.query(body_of(req));
};

// ---------- A2A 标准面 + peer 签名面 ----------
// 六个端点与上游 cicdkit/internal/a2a 同形：card 公开发现、/a2a 走 JSON-RPC、
// /peer/* 走 HMAC 签名（未配 CICDKIT_PEER_SHARED/ROOT 时整面 fail-closed 关闭）。
// 能力全只读，任何写入（发布/删除/SSH）都不在这两面里。
get "/.well-known/agent-card.json", (req) => {
  return { status: 200, body: a2a.card() };
};

// 上游这里是 302 到 "/"，但 Lume 的路由信封只能改 status/type/cache_control，
// 发不出 Location 头 —— 与其给一个没有 Location 的 302（客户端会当成坏响应），
// 不如明确回 405 并说清怎么用。
get "/a2a", (req) => {
  return {
    status: 405,
    body: {
      ok: false,
      error: "GET /a2a 不支持：JSON-RPC 走 POST /a2a，只读发现走 GET /.well-known/agent-card.json",
    },
  };
};

post "/a2a", (req) => { return a2a.rpc(req); };

get "/peer/health", (req) => { return a2a.peer_health(req); };
get "/peer/tools", (req) => { return a2a.peer_tools(req); };
post "/peer/invoke", (req) => { return a2a.peer_invoke(req); };
post "/peer/relay", (req) => { return a2a.peer_relay(req); };

// ---------- webhook（外部 CI 触发，不受角色闸门，用自己的 key 校验）----------
post "/api/webhook/:id", (req) => {
  return api.webhook(str(get(req.params, "id", "")), body_of(req), qstr(req, "secret", ""));
};

// ---------- 项目 ----------

get "/api/projects", (req) => {
  let blocked = read_gate(req, "project-read", "read", "项目列表");
  if (blocked != null) { return blocked; }
  let page = api.project_list(qstr(req, "q", ""), qlimit(req, "limit", 200), qint(req, "offset", 0));
  return { status: 200, body: page };
};

post "/api/projects", (req) => {
  let gate = abac(req, "project-admin", "create", "新建项目", "human_admin");
  if (not get(gate, "allowed", false)) { return denied(gate, "新建项目"); }
  return api.project_create(body_of(req));
};

// 放在 /api/projects/:id 之前：静态段优先匹配（路由按注册顺序，先命中先返回）。
post "/api/projects/scan", (req) => {
  let gate = abac(req, "project-admin", "scan", "扫描工作目录", "human_admin");
  if (not get(gate, "allowed", false)) { return denied(gate, "扫描工作目录"); }
  return api.project_scan(qstr(req, "dir", ""));
};

// 发布单独一条：唯一受审批闸门保护的动作（构建可重跑，发布不可逆）。
post "/api/projects/:id/deploy", (req) => {
  let id = str(get(req.params, "id", ""));
  // 资源表先拦一层；CICD_DEPLOY_APPROVAL 仍按原模式叠加（off / approve / execute）。
  let ab = access.decide(req, "deploy-publish", "publish");
  if (get(ab, "enabled", false)) { audit_access(req, ab, "deploy-publish", "publish", "发布"); }
  if (get(ab, "enabled", false) and not get(ab, "allowed", false)) { return denied(ab, "发布"); }
  let gate = guard.deploy_allowed(req);
  if (not get(gate, "allowed", false)) {
    return { status: 403, body: { ok: false, error: str(get(gate, "reason", "发布被审批闸门拒绝")), approval: gate } };
  }
  return api.project_deploy(id, body_of(req));
};

// 指定发布目标：POST /api/projects/:id/deploy?target=xxx 已经覆盖绝大多数用法，
// 这里保留一个 target 走 path 的形状，方便前端按目标列按钮。
post "/api/projects/:id/targets/:target/deploy", (req) => {
  let id = str(get(req.params, "id", ""));
  let target = str(get(req.params, "target", ""));
  // 资源表先拦一层；CICD_DEPLOY_APPROVAL 仍按原模式叠加（off / approve / execute）。
  let ab = access.decide(req, "deploy-publish", "publish");
  if (get(ab, "enabled", false)) { audit_access(req, ab, "deploy-publish", "publish", "发布"); }
  if (get(ab, "enabled", false) and not get(ab, "allowed", false)) { return denied(ab, "发布"); }
  let gate = guard.deploy_allowed(req);
  if (not get(gate, "allowed", false)) {
    return { status: 403, body: { ok: false, error: str(get(gate, "reason", "发布被审批闸门拒绝")), approval: gate } };
  }
  let port = trim(qstr(req, "port", ""));
  return api.project_deploy(id, "{\"target\":\"" + target + "\",\"port\":\"" + port + "\"}");
};

// 发布版本列表（只读）：给回滚下拉用。
get "/api/projects/:id/deploy-versions", (req) => {
  let blocked = read_gate(req, "project-read", "read", "发布版本列表");
  if (blocked != null) { return blocked; }
  return api.deploy_versions(str(get(req.params, "id", "")), qstr(req, "target", ""));
};

// 回滚上一版：和 deploy 一样属于"对外发布"，所以走同一个审批闸门。
// body 里可以带 image_ref / target，指定任意历史版本；不带就是"上一版"。
post "/api/projects/:id/rollback", (req) => {
  let id = str(get(req.params, "id", ""));
  // 资源表先拦一层；CICD_DEPLOY_APPROVAL 仍按原模式叠加（off / approve / execute）。
  let ab = access.decide(req, "deploy-publish", "publish");
  if (get(ab, "enabled", false)) { audit_access(req, ab, "deploy-publish", "publish", "发布"); }
  if (get(ab, "enabled", false) and not get(ab, "allowed", false)) { return denied(ab, "发布"); }
  let gate = guard.deploy_allowed(req);
  if (not get(gate, "allowed", false)) {
    return { status: 403, body: { ok: false, error: str(get(gate, "reason", "发布被审批闸门拒绝")), approval: gate } };
  }
  return api.project_rollback(id, body_of(req));
};

// ---------- 整体发布链路 ----------
//
// 一条链路 = 构建一次 → 本地 → 测试 → 生产。启动和推进都复用发布审批；
// 生产阶段另外要求 human_admin，并且 body 必须显式 confirm_prod=true。

get "/api/projects/:id/release-plan", (req) => {
  let blocked = read_gate(req, "project-read", "read", "发布链路计划");
  if (blocked != null) { return blocked; }
  return api.project_release_plan(str(get(req.params, "id", "")));
};

get "/api/projects/:id/releases", (req) => {
  let blocked = read_gate(req, "deployment-read", "read", "发布链路列表");
  if (blocked != null) { return blocked; }
  return api.project_release_list(str(get(req.params, "id", "")), qlimit(req, "limit", 20));
};

post "/api/projects/:id/release", (req) => {
  let ab = access.decide(req, "deploy-publish", "publish");
  if (get(ab, "enabled", false)) { audit_access(req, ab, "deploy-publish", "publish", "整体发布"); }
  if (get(ab, "enabled", false) and not get(ab, "allowed", false)) { return denied(ab, "整体发布"); }
  let gate = guard.deploy_allowed(req);
  if (not get(gate, "allowed", false)) {
    return { status: 403, body: { ok: false, error: str(get(gate, "reason", "整体发布被审批闸门拒绝")), approval: gate } };
  }
  // 首段就是生产时，启动请求也会带 confirm_prod；不能只靠后端校验 body，
  // 否则操作员可以自己塞 true 绕过 deploy-prod 的 human_admin 门禁。
  let br = try(() => json(body_of(req)));
  let body = {};
  if (get(br, "err", null) == null) { body = get(br, "ok", {}); }
  if (get(body, "confirm_prod", false) == true) {
    let pg = abac(req, "deploy-prod", "promote", "生产发布确认", "human_admin");
    if (not get(pg, "allowed", false)) { return denied(pg, "生产发布确认"); }
  }
  return api.project_release_start(str(get(req.params, "id", "")), body_of(req), actor_of(req));
};

get "/api/releases/:id", (req) => {
  let blocked = read_gate(req, "deployment-read", "read", "发布链路详情");
  if (blocked != null) { return blocked; }
  return api.release_get(str(get(req.params, "id", "")));
};

post "/api/releases/:id/advance", (req) => {
  let id = str(get(req.params, "id", ""));
  // 先按普通发布放行；body 明确 confirm_prod=true 时再叠加生产发布门禁。
  let ab = access.decide(req, "deploy-publish", "publish");
  if (get(ab, "enabled", false)) { audit_access(req, ab, "deploy-publish", "publish", "推进发布链路"); }
  if (get(ab, "enabled", false) and not get(ab, "allowed", false)) { return denied(ab, "推进发布链路"); }
  let gate = guard.deploy_allowed(req);
  if (not get(gate, "allowed", false)) {
    return { status: 403, body: { ok: false, error: str(get(gate, "reason", "推进发布链路被审批闸门拒绝")), approval: gate } };
  }
  let br = try(() => json(body_of(req)));
  let body = {};
  if (get(br, "err", null) == null) { body = get(br, "ok", {}); }
  if (get(body, "confirm_prod", false) == true) {
    let pg = abac(req, "deploy-prod", "promote", "生产发布确认", "human_admin");
    if (not get(pg, "allowed", false)) { return denied(pg, "生产发布确认"); }
  }
  return api.release_advance(id, body_of(req), actor_of(req));
};

post "/api/releases/:id/cancel", (req) => {
  let gate = abac(req, "run-control", "cancel", "取消发布链路", "agent_operator");
  if (not get(gate, "allowed", false)) { return denied(gate, "取消发布链路"); }
  return api.release_cancel(str(get(req.params, "id", "")), actor_of(req));
};

// 脚手架生成：必须在 :action 之前注册，否则会被当成未知动作。
get "/api/projects/:id/generate", (req) => {
  let id = str(get(req.params, "id", ""));
  let gate = abac(req, "project-admin", "generate", "生成项目脚手架", "human_admin");
  if (not get(gate, "allowed", false)) { return denied(gate, "生成项目脚手架"); }
