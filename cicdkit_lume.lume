// ---------- 云环境（只读） ----------

get "/api/environments", (req) => {
  let blocked = read_gate(req, "env-snapshot", "read", "云环境列表");
  if (blocked != null) { return blocked; }
  return { status: 200, body: api.environment_list() };
};

post "/api/environments/:host/snapshot", (req) => {
  // 身份绑定开启时按资源表判定；没开启才回退旧的“任意角色”闸门。
  let gate = access.decide(req, "env-snapshot", "read");
  if (get(gate, "enabled", false)) { audit_access(req, gate, "env-snapshot", "read", "云环境快照"); }
  if (not get(gate, "enabled", false)) { gate = guard.role_any(req, "云环境快照"); }
  if (not get(gate, "allowed", false)) { return denied(gate, "云环境快照"); }
  return api.environment_snapshot(str(get(req.params, "host", "")));
};

post "/api/environments/:host/actions", (req) => {
  let raw = body_of(req);
  let b = store.parse_json(raw, {});
  if (b == null) { b = {}; }
  let act = str(get(b, "action", ""));
  // 只读动作与重启动作分离成两个资源：(user, resource, action) 由资源表判定。
  let mutation = (act == "rollout-restart" or act == "docker-restart");
  let label = "云环境动作";
  let resource = "env-action-read";
  let action = "read";
  if (mutation) { resource = "env-action-mutate"; action = "restart"; }
  let gate = access.decide(req, resource, action);
  if (get(gate, "enabled", false)) { audit_access(req, gate, resource, action, label); }
  if (not get(gate, "enabled", false)) {
    gate = guard.role_any(req, label);
    if (mutation) { gate = guard.role_allowed(req, "human_admin", label); }
  }
  if (not get(gate, "allowed", false)) { return denied(gate, label); }
  // 审计必须能回答“谁点的”：身份绑定模式下写 user(role)，旧模式退回角色。
  let actor = str(get(gate, "role", ""));
  let who = str(get(gate, "user", ""));
  if (len(who) > 0) { actor = who + " (" + actor + ")"; }
  return api.environment_action(str(get(req.params, "host", "")), b, actor);
};

get "/api/environments/actions", (req) => {
  let blocked = read_gate(req, "env-action-read", "read", "云环境动作审计");
  if (blocked != null) { return blocked; }
  return { status: 200, body: api.environment_actions(qstr(req, "host", ""), qint(req, "since", 0), qint(req, "until", 0), qlimit(req, "limit", 20)) };
};

// 授权判定审计：每次资源/动作闸门判定都有一条，?user= / ?resource= 可过滤。
get "/api/audit/access", (req) => {
  let blocked = read_gate(req, "audit-read", "read", "授权审计");
  if (blocked != null) { return blocked; }
  return {
    status: 200,
    body: store.list_access_events(qstr(req, "user", ""), qstr(req, "resource", ""), qint(req, "since", 0), qint(req, "until", 0), qlimit(req, "limit", 50)),
  };
};

