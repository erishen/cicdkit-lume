// src/store.lume — 原生状态存储（SQLite），取代 cicdkit 的 store.json
//
// 为什么是「JSON blob + 少量索引列」而不是把每个字段拆成列：
// Project/Build/Deploy/Probe 的字段随版本一直在长（现在就有 targets[]、
// ssh_build_platforms[]、helm_values{} 这类嵌套），拆列等于每加一个字段就要
// 一次 schema 迁移；而 Lume 的 SQL 护栏不允许 DROP/ALTER TABLE（只允许
// CREATE TABLE 与 ALTER ADD），迁移能力本来就受限。所以：
//   - 整条记录留 json（读写都走 stringify/json，字段演进零成本）；
//   - 只把「要过滤、要排序、要分组」的字段单独列出来（id/name/status/时间/int）；
//   - 运行日志不进库：一个运行一个文件 <data>/logs/<run_id>.log，前端按字节
//     偏移增量拉（256KB 的日志写进 SQLite 只会让每次列表查询都变慢）。
//
// 时间：库里存 created_ts/updated_ts（整数 unix 秒）用于排序，展示用的
// created_at/updated_at 仍放在 json 里（导入的历史记录原样保留 cicdkit 的
// RFC3339 字符串，新建的记录用 fmt_iso 生成）。

// 自增序号必须放在 map 里：函数内对标量的赋值只改副本（写不回模块作用域），
// 直接用 `g_seq = g_seq + 1` 会让同一秒内的所有 new_id 返回同一个 id ——
// 同秒建两个项目/两条运行就会互相覆盖（INSERT OR REPLACE 静默吃掉前一条）。
let g_seq = { n: 0 };

// ---------- 路径 ----------

export func data_dir() {
  let d = env("LUME_DATA");
  let s = "";
  if (d != null) { s = trim(str(d)); }
  if (len(s) == 0) { return "./.data"; }
  if (substr(s, len(s) - 1) == "/") { return substr(s, 0, len(s) - 1); }
  return s;
}

export func db() { return data_dir() + "/store.db"; }
export func log_dir() { return data_dir() + "/logs"; }
// 归档目录：被 CICD_RUN_KEEP 裁掉的运行，日志搬到这里，随时能恢复。
export func archive_dir() { return data_dir() + "/logs-archive"; }
export func run_log_path(id) { return log_dir() + "/" + str(id) + ".log"; }

export func fmt_iso(ts) { return strftime("%Y-%m-%dT%H:%M:%S%z", ts); }

// ---------- 初始化 ----------
// sql_write 的路径模式用 SQLITE_OPEN_READWRITE（不会自动建库），所以先落一个
// 空文件再建表。CREATE TABLE IF NOT EXISTS 是幂等的，每次启动都跑一遍。

export func init() {
  mkdir(data_dir());
  mkdir(log_dir());
  if (read_file(db()) == null) { write_file(db(), ""); }

  sql_write(db(), "CREATE TABLE IF NOT EXISTS projects (id TEXT PRIMARY KEY, name TEXT, description TEXT, repository TEXT, branch TEXT, json TEXT, created_ts INTEGER, updated_ts INTEGER)");
  sql_write(db(), "CREATE TABLE IF NOT EXISTS runs (id TEXT PRIMARY KEY, project_id TEXT, project_name TEXT, trigger TEXT, status TEXT, image_ref TEXT, job_id TEXT, exit_code INTEGER, created_ts INTEGER, started_ts INTEGER, ended_ts INTEGER, json TEXT)");
  sql_write(db(), "CREATE TABLE IF NOT EXISTS deployments (id TEXT PRIMARY KEY, project_id TEXT, project_name TEXT, method TEXT, status TEXT, image_ref TEXT, created_ts INTEGER, json TEXT)");
  sql_write(db(), "CREATE TABLE IF NOT EXISTS kb (id TEXT PRIMARY KEY, project_id TEXT, project_name TEXT, stage TEXT, signature TEXT, error_keyword TEXT, created_ts INTEGER, json TEXT)");
  sql_write(db(), "CREATE TABLE IF NOT EXISTS settings (key TEXT PRIMARY KEY, value TEXT, updated_ts INTEGER)");
  sql_write(db(), "CREATE TABLE IF NOT EXISTS runs_archive (id TEXT PRIMARY KEY, project_id TEXT, json TEXT, archived_ts INTEGER, log_archived INTEGER, log_bytes INTEGER)");
  // 云环境受控动作审计：只记谁在什么主机上提交了什么动作、对应哪个 runner job。
  // 结果本身在 runner 日志里；这里保的是“动作发生过”的事实，runner 重启也不丢。
  sql_write(db(), "CREATE TABLE IF NOT EXISTS env_actions (id TEXT PRIMARY KEY, host TEXT, project_id TEXT, target TEXT, action TEXT, status TEXT, actor TEXT, job_id TEXT, created_ts INTEGER, json TEXT)");
  // 授权审计：每条资源/动作判定都留痕，成功和拒绝都记。只记判定，
  // 不代替 env_actions 的 job 终态；用户、角色、资源、动作、原因都在这里。
  sql_write(db(), "CREATE TABLE IF NOT EXISTS access_events (id TEXT PRIMARY KEY, ts INTEGER, user TEXT, role TEXT, resource TEXT, action TEXT, allowed INTEGER, reason TEXT, label TEXT, json TEXT)");
  // 整体发布链路：一条链路由多个阶段运行组成（构建 → 本地 → 测试 → 生产）。
  // 阶段状态和 run_id 都在 json 里，这里只保留列表/详情需要的列。
  sql_write(db(), "CREATE TABLE IF NOT EXISTS releases (id TEXT PRIMARY KEY, project_id TEXT, project_name TEXT, status TEXT, image_ref TEXT, current_stage INTEGER, created_ts INTEGER, updated_ts INTEGER, json TEXT)");
  mkdir(archive_dir());
}

// ---------- id ----------
// 与 cicdkit 的 GenID 一样形如 "proj-<hex>"，前端只当不透明串用。
// 这里没有 rand()，用 「秒 + 进程内自增」；同秒同序号只会出现在「进程重启且
// 恰好落到同一秒」的情形，create_* 里再查一次库做兜底。

func new_id(prefix) {
  put(g_seq, "n", int(get(g_seq, "n", 0)) + 1);
  return str(prefix) + "-" + str(now()) + "-" + str(int(get(g_seq, "n", 0)));
}

func id_free(table, prefix) {
  let i = 0;
  while (i < 20) {
    let id = new_id(prefix);
    let rows = sql_query(db(), "SELECT id FROM " + str(table) + " WHERE id = ?", [id]);
    if (len(rows) == 0) { return id; }
    i = i + 1;
  }
  return new_id(prefix);
}

export func parse_json(text, fallback) {
  if (text == null) { return fallback; }
  let s = str(text);
  if (len(s) == 0) { return fallback; }
  let r = try(() => json(s));
  if (r.err != null) { return fallback; }
  return r.ok;
}

func count_of(sql, params) {
  let rows = sql_query(db(), sql, params);
  if (len(rows) == 0) { return 0; }
  return int(get(rows[0], "n", 0));
}

// ---------- 项目 ----------

// q 为空时不过滤（? = '' 恒真，所以一条 SQL 覆盖两种情况）。
export func list_projects(q, limit, offset) {
  let qq = trim(str(q));
  let like = "%" + qq + "%";
  let where = "WHERE (? = '' OR name LIKE ? OR description LIKE ? OR repository LIKE ?)";
  let params = [qq, like, like, like];
  let total = count_of("SELECT COUNT(*) AS n FROM projects " + where, params);
  let rows = sql_query(db(),
    "SELECT json, created_ts, updated_ts FROM projects " + where +
    " ORDER BY updated_ts DESC, id DESC LIMIT " + str(int(limit)) + " OFFSET " + str(int(offset)),
    params);
  let out = [];
  let i = 0;
  while (i < len(rows)) {
    let row = rows[i];
    let p = parse_json(get(row, "json", ""), null);
    if (p != null) { push(out, p); }
    i = i + 1;
  }
  return { projects: out, total: total };
}

// 库里那份（含真值口令/私钥路径），只给服务端内部用。
// 给运维脚本用的原始行（含 json 与时间列），业务代码请用 list_projects/get_project。
export func project_rows() {
  return sql_query(db(), "SELECT id, json, created_ts FROM projects ORDER BY id", []);
}

// 历史运行/部署里也存着当初执行过的命令行（含 `--build-arg LLM_API_KEY=...`），
// 清洗脚本要能扫到它们；这两个只给运维脚本用。
export func run_rows() {
  return sql_query(db(), "SELECT id, json FROM runs ORDER BY id", []);
}

export func deployment_rows() {
  return sql_query(db(), "SELECT id, json FROM deployments ORDER BY id", []);
}

export func put_json(table, id, text) {
  let r = try(() => sql_write(db(), "UPDATE " + str(table) + " SET json = ? WHERE id = ?", [str(text), str(id)]));
  if (r.err != null) { return { ok: false, err: str(r.err) }; }
  return { ok: true, err: "" };
}

export func get_project(id) {
  let rows = sql_query(db(), "SELECT json FROM projects WHERE id = ?", [str(id)]);
  if (len(rows) == 0) { return null; }
  return parse_json(get(rows[0], "json", ""), null);
}

export func project_exists(id) {
  let rows = sql_query(db(), "SELECT id FROM projects WHERE id = ?", [str(id)]);
  return len(rows) > 0;
}

export func put_project(p, is_new) {
  let id = str(get(p, "id", ""));
  let ts = now();
  let created = int(get(p, "created_ts", 0));
  if (created == 0) { created = ts; }
  let sql = "INSERT OR REPLACE INTO projects (id, name, description, repository, branch, json, created_ts, updated_ts) VALUES (?, ?, ?, ?, ?, ?, " + str(created) + ", " + str(ts) + ")";
  let rows = [id,
    str(get(p, "name", "")),
    str(get(p, "description", "")),
    str(get(p, "repository", "")),
    str(get(p, "branch", "")),
    stringify(p)];
  let r = try(() => sql_write(db(), sql, rows));
  if (r.err != null) { return { ok: false, err: str(r.err) }; }
  return { ok: true, err: "" };
}

export func delete_project(id) {
  let n = sql_write(db(), "DELETE FROM projects WHERE id = ?", [str(id)]);
  return int(n);
}

// 删除项目时把它的运行/部署/知识库一起清掉：只删 projects 行会留下一堆
// 孤儿记录和日志文件，列表里仍然看得到「已删项目」的历史。
// 日志与归档日志都用截断代替删除（DSL 没有 remove_file）。
export func delete_project_cascade(id) {
  let pid = str(id);
  let run_ids = [];
  for (row in sql_query(db(), "SELECT id FROM runs WHERE project_id = ?", [pid])) {
    push(run_ids, str(get(row, "id", "")));
  }
  for (rid in run_ids) {
    write_file(run_log_path(rid), "");
    sql_write(db(), "DELETE FROM runs WHERE id = ?", [rid]);
  }
  let arc_ids = [];
  for (row in sql_query(db(), "SELECT id FROM runs_archive WHERE project_id = ?", [pid])) {
    push(arc_ids, str(get(row, "id", "")));
  }
  for (rid in arc_ids) {
    write_file(archive_dir() + "/" + str(rid) + ".log", "");
    sql_write(db(), "DELETE FROM runs_archive WHERE id = ?", [rid]);
  }
  let dep_count = int(sql_write(db(), "DELETE FROM deployments WHERE project_id = ?", [pid]));
  let kb_count = int(sql_write(db(), "DELETE FROM kb WHERE project_id = ?", [pid]));
  let prj = int(sql_write(db(), "DELETE FROM projects WHERE id = ?", [pid]));
  return { project: prj, runs: len(run_ids), archive: len(arc_ids), deployments: dep_count, kb: kb_count };
}

// ---------- 运行 ----------

export func list_runs(project_id, limit, offset) {
  let pid = trim(str(project_id));
  let where = "WHERE (? = '' OR project_id = ?)";
  let params = [pid, pid];
  let total = count_of("SELECT COUNT(*) AS n FROM runs " + where, params);
  let rows = sql_query(db(),
    "SELECT json, created_ts FROM runs " + where +
    " ORDER BY created_ts DESC, id DESC LIMIT " + str(int(limit)) + " OFFSET " + str(int(offset)),
    params);
  let out = [];
  let i = 0;
  while (i < len(rows)) {
    let r = parse_json(get(rows[i], "json", ""), null);
    if (r != null) { push(out, r); }
    i = i + 1;
  }
  return { runs: out, total: total };
}

export func get_run(id) {
  let rows = sql_query(db(), "SELECT json, job_id, exit_code FROM runs WHERE id = ?", [str(id)]);
  if (len(rows) == 0) { return null; }
  return parse_json(get(rows[0], "json", ""), null);
}

export func put_run(r) {
  let id = str(get(r, "id", ""));
  let created = int(get(r, "created_ts", 0));
  if (created == 0) { created = now(); }
  let started = int(get(r, "started_ts", 0));
  let ended = int(get(r, "ended_ts", 0));
  let sql = "INSERT OR REPLACE INTO runs (id, project_id, project_name, trigger, status, image_ref, job_id, exit_code, created_ts, started_ts, ended_ts, json) VALUES (?, ?, ?, ?, ?, ?, ?, " + str(int(get(r, "exit_code", -1))) + ", " + str(created) + ", " + str(started) + ", " + str(ended) + ", ?)";
  let params = [id,
    str(get(r, "project_id", "")),
    str(get(r, "project_name", "")),
    str(get(r, "trigger", "")),
    str(get(r, "status", "")),
    str(get(r, "image_ref", "")),
    str(get(r, "job_id", "")),
    stringify(r)];
  let res = try(() => sql_write(db(), sql, params));
  if (res.err != null) { return { ok: false, err: str(res.err) }; }
  return { ok: true, err: "" };
}

// 只更新状态/时间这类小字段：读-改-写，避免调用方每次都要拼接完整对象。
export func patch_run(id, changes) {
  let r = get_run(id);
  if (r == null) { return null; }
  let ks = keys(changes);
  let i = 0;
  while (i < len(ks)) {
    put(r, ks[i], get(changes, ks[i], null));
    i = i + 1;
  }
  put_run(r);
  return r;
}

export func finish_run(id, status, exit_code, ended_ts) {
  return patch_run(id, {
    status: str(status),
    exit_code: int(exit_code),
    ended_ts: int(ended_ts),
    ended_at: fmt_iso(int(ended_ts)),
  });
}

// 清空运行记录（DELETE 必须带 WHERE，护栏要求；这里用恒真条件代替）。
// 运行历史保留条数（CICD_RUN_KEEP，默认 300）。
export func run_keep() {
  let d = env("CICD_RUN_KEEP");
  if (d == null) { return 300; }
  let k = int(d);
  if (k <= 0) { return 300; }
  return k;
}

// 只留最近的 keep 条运行；更早的不删，而是搬进 runs_archive + logs-archive，
// 之后可以用 restore_run(id) 原样恢复（这是"可回滚"的那一半）。
// 没有这一步，runs 表和 logs 目录只涨不跌；而 SQLite 这边不允许 CREATE INDEX，
// 列表查询会随历史条数线性变慢，磁盘也一直被旧日志占着。
//
// 取日志的顺序也很关键：先把内容写进归档文件，再把原文件截成 0 字节
// （DSL 没有 remove_file / rename_file，写归档是唯一能保住内容的办法）。
export func archive_runs(keep) {
  let k = int(keep);
  if (k < 1) { k = 1; }
  let rows = sql_query(db(),
    "SELECT id, project_id, json FROM runs ORDER BY created_ts DESC, id DESC LIMIT -1 OFFSET " + str(k), []);
  let n = 0;
  for (row in rows) {
    let rid = str(get(row, "id", ""));
    if (len(rid) == 0) { continue; }
    let arc = 0;
    let bytes = 0;
    let got = try(() => read_file(run_log_path(rid)));
    if (got.err != null) {
      // read_file 抛错说明日志超过 16 MiB：这种归档不了，原文件留着别动，
      // 至少不会丢内容（log_archived=0 让界面/接口能说清楚）。
      bytes = -1;
    } else if (got.ok != null) {
      let txt = str(got.ok);
      arc = 1;
      if (len(txt) > 0) {
        write_file(archive_dir() + "/" + rid + ".log", txt);
        bytes = len(txt);
      }
      write_file(run_log_path(rid), "");
    }
    sql_write(db(),
      "INSERT OR REPLACE INTO runs_archive (id, project_id, json, archived_ts, log_archived, log_bytes) VALUES (?, ?, ?, " + str(now()) + ", " + str(arc) + ", " + str(bytes) + ")",
      [rid, str(get(row, "project_id", "")), str(get(row, "json", ""))]);
    sql_write(db(), "DELETE FROM runs WHERE id = ?", [rid]);
    n = n + 1;
  }
  return n;
}

// 兼容旧名字（jobs.start 之前调的是 trim_runs）。
export func trim_runs(keep) { return archive_runs(keep); }

// 归档保留条数（CICD_ARCHIVE_KEEP，默认 1000）。归档只进不出的话，磁盘会
// 被 logs-archive/ 慢慢吃满，所以按时间顺序清最老的那批。
export func archive_keep() {
  let d = env("CICD_ARCHIVE_KEEP");
  if (d == null) { return 1000; }
  let k = int(d);
  if (k <= 0) { return 1000; }
  return k;
}

// 清掉超出 keep 的最老归档：先清空归档日志文件（DSL 没有 remove_file），
// 再删 runs_archive 行。返回清掉的条数。
export func prune_archive(keep) {
  let k = int(keep);
  if (k < 1) { k = 1; }
  let rows = sql_query(db(),
    "SELECT id FROM runs_archive ORDER BY archived_ts ASC, id ASC LIMIT -1 OFFSET " + str(k), []);
  let n = 0;
  for (row in rows) {
    let rid = str(get(row, "id", ""));
    if (len(rid) == 0) { continue; }
    write_file(archive_dir() + "/" + rid + ".log", "");
    sql_write(db(), "DELETE FROM runs_archive WHERE id = ?", [rid]);
    n = n + 1;
  }
  return n;
}

export func count_archive() {
  let rows = sql_query(db(), "SELECT COUNT(*) AS n FROM runs_archive", []);
  if (len(rows) == 0) { return 0; }
  return int(get(rows[0], "n", 0));
}

export func list_archive(limit) {
  let rows = sql_query(db(),
    "SELECT id, project_id, json, archived_ts, log_archived, log_bytes FROM runs_archive ORDER BY archived_ts DESC, id DESC LIMIT " + str(int(limit)), []);
  let out = [];
  for (row in rows) {
    let r = parse_json(get(row, "json", ""), {});
    push(out, {
      id: str(get(row, "id", "")),
      project_id: str(get(row, "project_id", "")),
      project_name: str(get(r, "project_name", "")),
      status: str(get(r, "status", "")),
      image_ref: str(get(r, "image_ref", "")),
      archived_ts: int(get(row, "archived_ts", 0)),
      log_archived: int(get(row, "log_archived", 0)) == 1,
      log_bytes: int(get(row, "log_bytes", 0)),
    });
  }
  return out;
}

// 从归档里把一条运行连日志一起搬回来。返回 {ok, err, log_bytes}。
export func restore_run(id) {
  let rows = sql_query(db(),
    "SELECT json, log_archived, log_bytes FROM runs_archive WHERE id = ?", [str(id)]);
  if (len(rows) == 0) { return { ok: false, err: "归档里没有这个运行: " + str(id), log_bytes: 0 }; }
  let row = rows[0];
  let run = parse_json(str(get(row, "json", "")), null);
  if (run == null) { return { ok: false, err: "归档记录已损坏: " + str(id), log_bytes: 0 }; }
  let pr = put_run(run);
  if (not get(pr, "ok", false)) { return { ok: false, err: str(get(pr, "err", "写回运行记录失败")), log_bytes: 0 }; }
  let bytes = 0;
  if (int(get(row, "log_bytes", 0)) > 0) {
    let src = archive_dir() + "/" + str(id) + ".log";
    let got = try(() => read_file(src));
    if (got.ok != null) {
      let txt = str(got.ok);
      bytes = len(txt);
      write_file(run_log_path(str(id)), txt);
      write_file(src, "");
    }
  }
  sql_write(db(), "DELETE FROM runs_archive WHERE id = ?", [str(id)]);
  return { ok: true, err: "", log_bytes: bytes };
}

export func clear_runs() {
  let n = sql_write(db(), "DELETE FROM runs WHERE id <> ''");
  // 日志文件一并清空，否则 data 目录只涨不跌。DSL 没有 remove_file，
  // 用原子写把每个日志截成 0 字节（记录已删，内容留着也没人引用）。
  let names = files(log_dir());
  let i = 0;
  while (i < len(names)) {
    let nm = str(names[i]);
    if (contains(nm, ".log") and not contains(nm, "/")) {
      write_file(log_dir() + "/" + nm, "");
    }
    i = i + 1;
  }
  return int(n);
}

// 日志尾：from 是客户端已渲染的字节偏移；0 = 从尾部最多 tail_max 字节开始。
// read_file 有 16 MiB 硬上限（无分片读），所以超过这个长度的日志只能给前 16 MiB。
// 必须把这件事显式报出来：否则前端按 log_len 推进偏移，会以为日志「读完了」。
let LOG_READ_MAX = 16777216;

export func read_log_tail(run_id, from, tail_max) {
  let path = run_log_path(run_id);
  // read_file 对超过 16 MiB 的文件是**抛错**而不是截断：不 try 住的话，
  // 一个超大日志会让整个接口 500，前端一片空白。runner 虽然已经封顶，
  // 但老 runner 或人为塞进来的大文件仍会走到这里。
  let got = try(() => read_file(path));
  if (got.err != null) {
    return { log: "", log_len: 0, from: 0, reset: true, truncated: true, err: str(got.err) };
  }
  let text = got.ok;
  if (text == null) { return { log: "", log_len: 0, from: 0, reset: from > 0, truncated: false }; }
  let src = str(text);
  let total = len(src);
  let start = int(from);
  let reset = false;
  if (start <= 0 or start > total) {
    if (total > int(tail_max)) { start = total - int(tail_max); } else { start = 0; }
    reset = true;
  }
  let truncated = total >= LOG_READ_MAX;
  return { log: substr(src, start, total - start), log_len: total, from: start, reset: reset, truncated: truncated };
}

export func write_log(run_id, text) {
  return write_file(run_log_path(run_id), str(text));
}

// ---------- 部署 ----------

export func list_deployments(project_id, limit, offset) {
  let pid = trim(str(project_id));
  let where = "WHERE (? = '' OR project_id = ?)";
  let params = [pid, pid];
  let total = count_of("SELECT COUNT(*) AS n FROM deployments " + where, params);
  let rows = sql_query(db(),
    "SELECT json FROM deployments " + where +
    " ORDER BY created_ts DESC, id DESC LIMIT " + str(int(limit)) + " OFFSET " + str(int(offset)),
    params);
  let out = [];
  let i = 0;
  while (i < len(rows)) {
    let d = parse_json(get(rows[i], "json", ""), null);
    if (d != null) { push(out, d); }
    i = i + 1;
  }
  return { deployments: out, total: total };
}

export func get_deployment(id) {
  let rows = sql_query(db(), "SELECT json FROM deployments WHERE id = ?", [str(id)]);
  if (len(rows) == 0) { return null; }
  return parse_json(get(rows[0], "json", ""), null);
}

// 回滚用：找同一个发布目标上、上上次成功发布的镜像。
// deployments 只记成功（失败不写库），所以这里再按 status 过一道只是兜底。
// 同一镜像连着发两次算一次（跳过与"当前这版"相同的记录）。
export func prev_deploy(project_id, want_target) {
  let tgt = trim(str(want_target));
  let rows = sql_query(db(),
    "SELECT json, image_ref, status FROM deployments WHERE project_id = ? ORDER BY created_ts DESC, id DESC LIMIT 500",
    [str(project_id)]);
  let cur = "";
  let cur_tgt = "";
  for (row in rows) {
    if (str(get(row, "status", "")) != "success") { continue; }
    let img = trim(str(get(row, "image_ref", "")));
    if (len(img) == 0) { continue; }
    let d = parse_json(str(get(row, "json", "")), {});
    let t = str(get(d, "target", ""));
    if (len(tgt) > 0 and t != tgt) { continue; }
    if (len(cur) == 0) { cur = img; cur_tgt = t; continue; }
    if (img != cur) { return { ok: true, image_ref: img, target: t, current_image: cur, err: "" }; }
  }
  return { ok: false, image_ref: "", target: cur_tgt, current_image: cur, err: "没有更早的成功发布可以回滚" };
}

// 发布版本列表（同一目标上去重、按时间倒序），给"回滚到任意一版"下拉用。
export func deploy_versions(project_id, want_target, limit) {
  let tgt = trim(str(want_target));
  let rows = sql_query(db(),
    "SELECT json, image_ref, status, created_ts FROM deployments WHERE project_id = ? ORDER BY created_ts DESC, id DESC LIMIT 500",
    [str(project_id)]);
  let out = [];
  let seen = {};
  for (row in rows) {
    if (str(get(row, "status", "")) != "success") { continue; }
    let img = trim(str(get(row, "image_ref", "")));
    if (len(img) == 0) { continue; }
    let d = parse_json(str(get(row, "json", "")), {});
    let t = str(get(d, "target", ""));
    if (len(tgt) > 0 and t != tgt) { continue; }
    if (get(seen, img, "") != "") { continue; }
    put(seen, img, "1");
    push(out, {
      image_ref: img,
      target: t,
      created_ts: int(get(row, "created_ts", 0)),
      created_at: str(get(d, "created_at", "")),
      deploy_id: str(get(d, "id", "")),
    });
    if (len(out) >= int(limit)) { break; }
  }
  return out;
}

export func put_deployment(d) {
  let id = str(get(d, "id", ""));
  if (len(id) == 0) { id = id_free("deployments", "dep"); put(d, "id", id); }
  let created = int(get(d, "created_ts", 0));
  if (created == 0) { created = now(); }
  let sql = "INSERT OR REPLACE INTO deployments (id, project_id, project_name, method, status, image_ref, created_ts, json) VALUES (?, ?, ?, ?, ?, ?, " + str(created) + ", ?)";
  let params = [id,
    str(get(d, "project_id", "")),
    str(get(d, "project_name", "")),
    str(get(d, "method", "")),
    str(get(d, "status", "")),
    str(get(d, "image_ref", "")),
    stringify(d)];
  let res = try(() => sql_write(db(), sql, params));
  if (res.err != null) { return { ok: false, err: str(res.err) }; }
  return { ok: true, err: "" };
}

export func clear_deployments() {
  let n = sql_write(db(), "DELETE FROM deployments WHERE id <> ''");
  return int(n);
}

// ---------- 整体发布链路 ----------

export func release_keep() {
  let d = env("CICD_RELEASE_KEEP");
  let n = 200;
  if (d != null and len(trim(str(d))) > 0) { n = int(str(d)); }
  if (n < 10) { n = 10; }
  return n;
}

export func put_release(r) {
  let id = str(get(r, "id", ""));
  if (len(id) == 0) { return { ok: false, err: "release id 为空" }; }
  let created = int(get(r, "created_ts", 0));
  if (created == 0) { created = now(); }
  let updated = int(get(r, "updated_ts", 0));
  if (updated == 0) { updated = created; }
  put(r, "created_ts", created);
  put(r, "updated_ts", updated);
  if (len(str(get(r, "created_at", ""))) == 0) { put(r, "created_at", fmt_iso(created)); }
  if (len(str(get(r, "updated_at", ""))) == 0) { put(r, "updated_at", fmt_iso(updated)); }
  let sql = "INSERT OR REPLACE INTO releases (id, project_id, project_name, status, image_ref, current_stage, created_ts, updated_ts, json) VALUES (?, ?, ?, ?, ?, " + str(int(get(r, "current", -1))) + ", " + str(created) + ", " + str(updated) + ", ?)";
  let params = [id,
    str(get(r, "project_id", "")), str(get(r, "project_name", "")),
    str(get(r, "status", "")), str(get(r, "image_ref", "")), stringify(r)];
  let res = try(() => sql_write(db(), sql, params));
  if (res.err != null) { return { ok: false, err: str(res.err) }; }
  prune_releases(release_keep());
  return { ok: true, err: "" };
}

export func get_release(id) {
  let rows = sql_query(db(), "SELECT json FROM releases WHERE id = ?", [str(id)]);
  if (len(rows) == 0) { return null; }
  return parse_json(get(rows[0], "json", ""), null);
}

export func latest_release(project_id) {
  let rows = sql_query(db(), "SELECT json FROM releases WHERE project_id = ? ORDER BY created_ts DESC, id DESC LIMIT 1", [str(project_id)]);
  if (len(rows) == 0) { return null; }
  return parse_json(get(rows[0], "json", ""), null);
}

export func list_releases(project_id, limit) {
  let n = int(limit);
  if (n <= 0) { n = 20; }
  if (n > 200) { n = 200; }
  let rows = [];
  if (len(trim(str(project_id))) > 0) {
    rows = sql_query(db(), "SELECT json FROM releases WHERE project_id = ? ORDER BY created_ts DESC, id DESC LIMIT " + str(n), [str(project_id)]);
  } else {
    rows = sql_query(db(), "SELECT json FROM releases ORDER BY created_ts DESC, id DESC LIMIT " + str(n), []);
  }
  let out = [];
  let i = 0;
  while (i < len(rows)) {
    let r = parse_json(get(rows[i], "json", ""), null);
    if (r != null) { push(out, r); }
    i = i + 1;
  }
  return out;
}

// 只裁终态链路：running / ready / queued 还在等下一页轮询推进，不能删。
export func prune_releases(keep) {
  let k = int(keep);
  if (k < 10) { k = 10; }
  let rows = sql_query(db(), "SELECT COUNT(*) AS n FROM releases", []);
  let total = 0;
  if (len(rows) > 0) { total = int(get(rows[0], "n", 0)); }
  if (total <= k) { return 0; }
  let cut = total - k;
  let rows2 = sql_query(db(), "SELECT id FROM releases WHERE status = 'success' OR status = 'failed' OR status = 'canceled' ORDER BY created_ts ASC, id ASC LIMIT " + str(cut), []);
  let n = 0;
  let j = 0;
  while (j < len(rows2)) {
    let res = try(() => sql_write(db(), "DELETE FROM releases WHERE id = ?", [str(get(rows2[j], "id", ""))]));
    if (res.err == null) { n = n + 1; }
    j = j + 1;
  }
  return n;
}

// ---------- 知识库 ----------
// 条目结构照抄 cicdkit kb.json：signature 是关键（同项目同阶段同错误 → 复用结论）。

export func list_kb(q, limit) {
  let qq = trim(str(q));
  let like = "%" + qq + "%";
  let params = [qq, like, like, like, like];
  // diagnosis 只存在于 json 列里（不做独立列），所以用 json LIKE 兜住全文搜索。
  let where = "WHERE (? = '' OR project_name LIKE ? OR stage LIKE ? OR error_keyword LIKE ? OR json LIKE ?)";
  let rows = sql_query(db(),
    "SELECT json FROM kb " + where +
    " ORDER BY created_ts DESC, id DESC LIMIT " + str(int(limit)),
    params);
  let out = [];
  let i = 0;
  while (i < len(rows)) {
    let e = parse_json(get(rows[i], "json", ""), null);
    if (e != null) { push(out, e); }
    i = i + 1;
  }
  return { entries: out };
}

export func kb_by_signature(sig) {
  let rows = sql_query(db(), "SELECT json FROM kb WHERE signature = ?", [str(sig)]);
  if (len(rows) == 0) { return null; }
  return parse_json(get(rows[0], "json", ""), null);
}

export func put_kb(entry) {
  let id = str(get(entry, "id", ""));
  if (len(id) == 0) { id = id_free("kb", "kb"); put(entry, "id", id); }
  let created = int(get(entry, "created_ts", 0));
  if (created == 0) { created = now(); }
  if (len(str(get(entry, "created_at", ""))) == 0) { put(entry, "created_at", fmt_iso(created)); }
  let sql = "INSERT OR REPLACE INTO kb (id, project_id, project_name, stage, signature, error_keyword, created_ts, json) VALUES (?, ?, ?, ?, ?, ?, " + str(created) + ", ?)";
  let params = [id,
    str(get(entry, "project_id", "")),
    str(get(entry, "project_name", "")),
    str(get(entry, "stage", "")),
    str(get(entry, "signature", "")),
    str(get(entry, "error_keyword", "")),
    stringify(entry)];
  let res = try(() => sql_write(db(), sql, params));
  if (res.err != null) { return { ok: false, err: str(res.err) }; }
  return { ok: true, err: "" };
}

export func delete_kb(id) {
  let n = sql_write(db(), "DELETE FROM kb WHERE id = ?", [str(id)]);
  return int(n);
}

// ---------- 云环境动作审计 ----------

// 终态审计保留上限：默认 5000 条，最少 100。submitted 的记录可能还有 runner
// job 在跑，不参与裁剪，否则 finish_env_action 会找不到回写目标。
func env_audit_keep() {
  let v = env("CICD_ENV_AUDIT_KEEP");
  let n = 5000;
  if (v != null) { n = int(str(v)); }
  if (n < 100) { n = 100; }
  return n;
}

export func prune_env_actions(keep) {
  let k = int(keep);
  if (k < 100) { k = 100; }
  let rows = sql_query(db(), "SELECT COUNT(*) AS n FROM env_actions", []);
  let total = 0;
  if (len(rows) > 0) { total = int(get(rows[0], "n", 0)); }
  if (total <= k) { return 0; }
  let cut = total - k;
  let rows2 = sql_query(db(), "SELECT id FROM env_actions WHERE status <> 'submitted' ORDER BY created_ts ASC, id ASC LIMIT " + str(cut), []);
  let n = 0;
  let j = 0;
  while (j < len(rows2)) {
    let res = try(() => sql_write(db(), "DELETE FROM env_actions WHERE id = ?", [str(get(rows2[j], "id", ""))]));
    if (res.err == null) { n = n + 1; }
    j = j + 1;
  }
  return n;
}

export func put_env_action(e) {
  let id = str(get(e, "id", ""));
  if (len(id) == 0) { id = id_free("env_actions", "envact"); put(e, "id", id); }
  let created = int(get(e, "created_ts", 0));
  if (created == 0) { created = now(); }
  put(e, "created_ts", created);
  if (len(str(get(e, "created_at", ""))) == 0) { put(e, "created_at", fmt_iso(created)); }
  let sql = "INSERT OR REPLACE INTO env_actions (id, host, project_id, target, action, status, actor, job_id, created_ts, json) VALUES (?, ?, ?, ?, ?, ?, ?, ?, " + str(created) + ", ?)";
  let params = [id,
    str(get(e, "host", "")), str(get(e, "project_id", "")), str(get(e, "target", "")),
    str(get(e, "action", "")), str(get(e, "status", "")), str(get(e, "actor", "")),
    str(get(e, "job_id", "")), stringify(e)];
  let res = try(() => sql_write(db(), sql, params));
  if (res.err != null) { return { ok: false, err: str(res.err), id: id }; }
  prune_env_actions(env_audit_keep());
  return { ok: true, err: "", id: id };
}

// 把 runner job 的终态回写到审计行。runner 重启后日志可能丢，但“动作最后
// 成功还是失败”必须能在审计里看到；同一条记录只允许从 submitted 迁移一次。
export func finish_env_action(job_id, status, exit) {
  let jid = trim(str(job_id));
  if (len(jid) == 0) { return { ok: false, err: "job_id 不能为空" }; }
  let rows = sql_query(db(), "SELECT json FROM env_actions WHERE job_id = ?", [jid]);
  if (len(rows) == 0) { return { ok: false, err: "审计记录不存在", job_id: jid }; }
  let e = parse_json(get(rows[0], "json", ""), null);
  if (e == null) { e = {}; }
  let cur = str(get(e, "status", ""));
  if (cur == "success" or cur == "failed" or cur == "canceled") {
    return { ok: true, id: str(get(e, "id", "")), unchanged: true };
  }
  let ts = now();
  put(e, "status", str(status));
  put(e, "exit", int(exit));
  put(e, "finished_ts", ts);
  put(e, "finished_at", fmt_iso(ts));
  let sql = "UPDATE env_actions SET status = ?, json = ? WHERE job_id = ?";
  let res = try(() => sql_write(db(), sql, [str(status), stringify(e), jid]));
  if (res.err != null) { return { ok: false, err: str(res.err), job_id: jid }; }
  prune_env_actions(env_audit_keep());
  return { ok: true, id: str(get(e, "id", "")), unchanged: false };
}

// ---------- 授权判定审计 ----------

// 审计保留上限：默认 5000 条，最少 100。每次写入后裁掉最旧的多余记录，
// 避免长期运行把 SQLite 撑大；环境变量用 CICD_AUDIT_KEEP 覆盖。
func audit_keep() {
  let v = env("CICD_AUDIT_KEEP");
  let n = 5000;
  if (v != null) { n = int(str(v)); }
  if (n < 100) { n = 100; }
  return n;
}

export func prune_access_events(keep) {
  let k = int(keep);
  if (k < 100) { k = 100; }
  let rows = sql_query(db(), "SELECT COUNT(*) AS n FROM access_events", []);
  let total = 0;
  if (len(rows) > 0) { total = int(get(rows[0], "n", 0)); }
  if (total <= k) { return 0; }
  let cut = total - k;
  // Lume 的 SQL 沙箱对 DELETE ... IN (SELECT ...) 支持不稳，先取最旧的 id 再逐条删。
  let rows2 = sql_query(db(), "SELECT id FROM access_events ORDER BY ts ASC, id ASC LIMIT " + str(cut), []);
  let n = 0;
  let j = 0;
  while (j < len(rows2)) {
    let res = try(() => sql_write(db(), "DELETE FROM access_events WHERE id = ?", [str(get(rows2[j], "id", ""))]));
    if (res.err == null) { n = n + 1; }
    j = j + 1;
  }
  return n;
}

export func put_access_event(e) {
  let id = str(get(e, "id", ""));
  if (len(id) == 0) { id = id_free("access_events", "accevt"); put(e, "id", id); }
  let ts = int(get(e, "ts", 0));
  if (ts == 0) { ts = now(); }
  put(e, "ts", ts);
  if (len(str(get(e, "created_at", ""))) == 0) { put(e, "created_at", fmt_iso(ts)); }
  let allowed = 0;
  if (get(e, "allowed", false)) { allowed = 1; }
  let sql = "INSERT OR REPLACE INTO access_events (id, ts, user, role, resource, action, allowed, reason, label, json) VALUES (?, " + str(ts) + ", ?, ?, ?, ?, " + str(allowed) + ", ?, ?, ?)";
  let params = [id,
    str(get(e, "user", "")), str(get(e, "role", "")), str(get(e, "resource", "")),
    str(get(e, "action", "")), str(get(e, "reason", "")), str(get(e, "label", "")),
    stringify(e)];
  let res = try(() => sql_write(db(), sql, params));
  if (res.err != null) { return { ok: false, err: str(res.err), id: id }; }
  prune_access_events(audit_keep());
  return { ok: true, err: "", id: id };
}

export func list_access_events(user, resource, since, until, limit) {
  let u = trim(str(user));
  let r = trim(str(resource));
  let from = int(since);
  let to = int(until);
  if (from < 0) { from = 0; }
  if (to < 0) { to = 0; }
  let n = int(limit);
  if (n < 1) { n = 50; }
  if (n > 500) { n = 500; }
  let range = "";
  if (from > 0) { range = range + " AND ts >= " + str(from); }
  if (to > 0) { range = range + " AND ts <= " + str(to); }
  let rows = sql_query(db(),
    "SELECT json FROM access_events WHERE (? = '' OR user = ?) AND (? = '' OR resource = ?)" +
    range + " ORDER BY ts DESC, id DESC LIMIT " + str(n),
    [u, u, r, r]);
  let out = [];
  let i = 0;
  while (i < len(rows)) {
    let e = parse_json(get(rows[i], "json", ""), null);
    if (e != null) { push(out, e); }
    i = i + 1;
  }
  return { events: out };
}

export func list_env_actions(host, since, until, limit) {
  let h = trim(str(host));
  let from = int(since);
  let to = int(until);
  if (from < 0) { from = 0; }
  if (to < 0) { to = 0; }
  let n = int(limit);
  if (n < 1) { n = 20; }
  if (n > 500) { n = 500; }
  let where = "WHERE (? = '' OR host = ?)";
  if (from > 0) { where = where + " AND created_ts >= " + str(from); }
  if (to > 0) { where = where + " AND created_ts <= " + str(to); }
  let params = [h, h];
  let rows = sql_query(db(),
    "SELECT json FROM env_actions " + where +
    " ORDER BY created_ts DESC, id DESC LIMIT " + str(n),
    params);
  let out = [];
  let i = 0;
  while (i < len(rows)) {
    let e = parse_json(get(rows[i], "json", ""), null);
    if (e != null) { push(out, e); }
    i = i + 1;
  }
  return { actions: out };
}

// ---------- 设置（LLM 配置等）----------

export func get_setting(key) {
  let rows = sql_query(db(), "SELECT value FROM settings WHERE key = ?", [str(key)]);
  if (len(rows) == 0) { return null; }
  return parse_json(get(rows[0], "value", ""), null);
}

export func put_setting(key, value) {
  let sql = "INSERT OR REPLACE INTO settings (key, value, updated_ts) VALUES (?, ?, " + str(now()) + ")";
  let res = try(() => sql_write(db(), sql, [str(key), stringify(value)]));
  if (res.err != null) { return { ok: false, err: str(res.err) }; }
  return { ok: true, err: "" };
}

export func delete_setting(key) {
  return int(sql_write(db(), "DELETE FROM settings WHERE key = ?", [str(key)]));
}

// ---------- 历史数据导入（一次性）----------
// cicdkit 的数据在两个文件里：store.json {projects, runs, deployments} 与 kb.json
// （条目数组）。容器里把这两个文件挂到 <data>/ 下，首次启动时如果库是空的就导入，
// 之后不再碰（幂等：只看 projects 表是否为空）。
//
// 运行日志：store.json 里每条 run 的 log 字段（最长 256KB）被写成
// logs/<run_id>.log 并从 json 里摘掉 —— 库里只留元数据。

export func empty() {
  return count_of("SELECT COUNT(*) AS n FROM projects", []) == 0 and
    count_of("SELECT COUNT(*) AS n FROM runs", []) == 0;
}

export func import_legacy() {
  if (not empty()) { return { imported: false, reason: "store 非空，跳过导入" }; }

  let base = data_dir();
  let raw = read_file(base + "/store.json");
  // 注意：env() 未设置时返回 null，不能直接 get(null, ...) —— 会在启动时抛
  // "get() expects a map or list and a key"，表现为「服务起不来」。
  if (raw == null) {
    let alt = env("CICD_LEGACY_STORE");
    if (alt != null and len(trim(str(alt))) > 0) { raw = read_file(trim(str(alt))); }
  }
  let projects = 0;
  let runs = 0;
  let deployments = 0;

  if (raw != null) {
    let data = parse_json(str(raw), null);
    if (data != null) {
      let ps = get(data, "projects", []);
      let i = 0;
      while (i < len(ps)) {
        let p = ps[i];
        if (len(str(get(p, "id", ""))) == 0) { put(p, "id", id_free("projects", "proj")); }
        ensure_created(p, "created_at", "updated_at");
        put_project(p, true);
        projects = projects + 1;
        i = i + 1;
      }

      let rs = get(data, "runs", []);
      let j = 0;
      while (j < len(rs)) {
        let r = rs[j];
        if (len(str(get(r, "id", ""))) == 0) { put(r, "id", id_free("runs", "run")); }
        let id = str(get(r, "id", ""));
        let log = str(get(r, "log", ""));
        if (len(log) > 0) { write_log(id, log); }
        // log 不留在 json 里（库里只存元数据，日志走文件）
        let slim = {};
        let ks = keys(r);
        let k = 0;
        while (k < len(ks)) {
          if (ks[k] != "log") { put(slim, ks[k], get(r, ks[k], null)); }
          k = k + 1;
        }
        ensure_created(slim, "created_at", "started_at");
        put_run(slim);
        runs = runs + 1;
        j = j + 1;
      }

      let ds = get(data, "deployments", []);
      let m = 0;
      while (m < len(ds)) {
        let d = ds[m];
        if (len(str(get(d, "id", ""))) == 0) { put(d, "id", id_free("deployments", "dep")); }
        ensure_created(d, "created_at", "created_at");
        put_deployment(d);
        deployments = deployments + 1;
        m = m + 1;
      }
    }
  }

  let kbraw = read_file(base + "/kb.json");
  let kb_n = 0;
  if (kbraw != null) {
    let kb = parse_json(str(kbraw), null);
    if (kb != null) {
      // kb.json 有两种历史形状：[...] 与 {"entries": [...]}。get(list, "entries")
      // 会报 "list index must be a number"，所以先用 try 探一下是不是 map。
      let entries = kb;
      let probe = try(() => get(kb, "entries", null));
      if (probe.err == null and probe.ok != null) { entries = probe.ok; }
      let i2 = 0;
      while (i2 < len(entries)) {
        let e = entries[i2];
        ensure_created(e, "created_at", "adopted_at");
        put_kb(e);
        kb_n = kb_n + 1;
        i2 = i2 + 1;
      }
    }
  }

  return { imported: true, projects: projects, runs: runs, deployments: deployments, kb: kb_n };
}

// 导入的记录里 created_at 等字段由 cicdkit 写过；缺了就按当前时间补一个，
// 保证前端「时间」列不会出现空值（排序只用整数列，不依赖这里）。
func ensure_created(obj, created_key, updated_key) {
  let ca = str(get(obj, "created_at", ""));
  if (len(ca) == 0) {
    put(obj, created_key, fmt_iso(now()));
  }
  let ua = str(get(obj, updated_key, ""));
  if (len(ua) == 0) {
    put(obj, updated_key, str(get(obj, created_key, "")));
  }
}
