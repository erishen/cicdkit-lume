// src/secrets.lume —— 构建参数里的密钥引用（`secret:<名字>`）
//
// 为什么要这一层：docker build 的 `--build-arg K=V` 会把 V 原样拼进 argv，
// 而 argv 会被 runner 打印进日志（`$ docker build --build-arg LLM_API_KEY=sk-...`），
// 于是密钥就永久躺在 .data/logs/*.log 里，也会出现在 ps 输出里。
//
// 做法：密钥不进 argv，改走 step 的 env —— docker 支持 `--build-arg K`（不带 =）
// 时从进程环境读 K。runner 只记录 argv，不记录 env，所以日志里只剩
// `--build-arg LLM_API_KEY`，值一个字都不出现。
//
// 引用写法：build_args 的某个值写成 `secret:<名字>`，名字对应
// $LUME_DATA/secrets/<名字>（一行，首尾空白会被 trim）。
// 用文件而不是控制面环境变量，是因为控制面的 env() 会把名字里含
// API_KEY / TOKEN / SECRET / PASSWORD / CREDENTIAL 的变量屏蔽成 null——
// 而构建参数恰好最爱叫 *_API_KEY，走环境变量根本读不到。
//
// 这里刻意不做「引用解析失败就退化成空值」：空着传进去只会让构建多一个
// 莫名的错误，明确报错并指出该建哪个文件更有用。

import "store.lume" as store;

let PREFIX = "secret:";
// 名字只允许这些字符：它会拼进文件路径，放行 `/` 与 `..` 等于开后门。
let NAME_OK = "^[A-Za-z0-9][A-Za-z0-9._-]*$";

export func is_ref(v) {
  let s = trim(str(v));
  if (len(s) < len(PREFIX)) { return false; }
  return substr(s, 0, len(PREFIX)) == PREFIX;
}

export func secrets_dir() {
  return store.data_dir() + "/secrets";
}

export func secret_path(name) {
  return secrets_dir() + "/" + trim(str(name));
}

// → { ok, value, err, name }
export func resolve(v) {
  let name = trim(str(v));
  if (not is_ref(name)) { return { ok: false, value: "", name: "", err: "不是 secret: 引用" }; }
  name = trim(substr(name, len(PREFIX), len(name) - len(PREFIX)));
  if (not str_match(NAME_OK, name)) { return { ok: false, value: "", name: name, err: "非法的密钥名: " + name }; }
  let raw = read_file(secret_path(name));
  if (raw == null) {
    // 文件在但读不出来（权限/容器 uid 不匹配）与「根本没有」是两种故障，
    // 报错要能分开，否则会让人对着一个明明存在的文件反复找原因。
    let ents = files(secrets_dir());
    let k = 0;
    let present = false;
    while (k < len(ents)) { if (str(ents[k]) == name) { present = true; } k = k + 1; }
    if (present) {
      return { ok: false, value: "", name: name, err: "密钥文件不可读（权限或容器 uid 不匹配）: " + secret_path(name) };
    }
    return {
      ok: false,
      value: "",
      name: name,
      err: "缺少密钥文件 " + secret_path(name) + "（用 make secret NAME=" + name + " VALUE=… 写入）",
    };
  }
  let val = trim(str(raw));
  if (len(val) == 0) { return { ok: false, value: "", name: name, err: "密钥文件为空: " + secret_path(name) }; }
  return { ok: true, value: val, name: name, err: "" };
}

// 供脚本/运维用：写入密钥文件（目录 0700，文件走 write_file 的原子写）。
export func write_secret(name, value) {
  let n = trim(str(name));
  if (not str_match(NAME_OK, n)) { return { ok: false, err: "非法的密钥名: " + n }; }
  let v = trim(str(value));
  if (len(v) == 0) { return { ok: false, err: "空值不写入" }; }
  mkdir(secrets_dir());
  if (not write_file(secret_path(n), v + "\n")) { return { ok: false, err: "写入失败: " + secret_path(n) }; }
  return { ok: true, path: secret_path(n), err: "" };
}
