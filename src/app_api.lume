// src/app_api.lume — 控制面自身的 API 实现（不再转发给 cicdkit）
//
// 视图字段与 cicdkit 的 JSON tag 保持一致：前端 React 组件是按那些键名写的，
// 换后端不该顺手改协议。差异只体现在「谁提供数据」：这里全部来自本地 SQLite
// （src/store.lume）与本地 runner（src/exec.lume）。

import "store.lume" as store;
import "redact.lume" as redact;
import "validate.lume" as validate;
import "exec.lume" as exec;
import "jobs.lume" as jobs;
import "generate.lume" as generate;
import "release.lume" as release;

// ---------- 小工具 ----------

func sget(m, k, def) {
  if (m == null) { return def; }
  let v = get(m, k, null);
  if (v == null) { return def; }
  return v;
}

func s(v, def) {
  if (v == null) { return def; }
  let t = str(v);
  if (len(t) == 0) { return def; }
  return t;
}

func clamp_int(v, def, lo, hi) {
  let n = int(v);
  if (n < lo) { n = lo; }
  if (n > hi) { n = hi; }
  if (n == 0) { return def; }
  return n;
}

func parse_body(raw) {
  if (raw == null) { return {}; }
  let t = str(raw);
  if (len(t) == 0) { return {}; }
  let p = try(() => json(t));
  if (p.err != null) { return null; }
  return p.ok;
}

// ---------- 健康 / 元信息 ----------

export func health() {
  let st_ok = true;
  let err = "";
  let r = try(() => store.init());
  if (r.err != null) { st_ok = false; err = str(r.err); }
  let alive = false;
  let are = try(() => exec.alive());
  if (are.err == null) { alive = bool(are.ok); }
  // runner 连不上时别再报 200：这个字段就是给面板/监控看的。
  let up_status = 0;
  if (alive) { up_status = 200; }
  return {
    ok: st_ok and alive,
    service: "cicdkit-lume",
    upstream: exec.runner_base(),
    upstream_status: up_status,
    runner_ok: alive,
    store_ok: st_ok,
    version: { version: "native", mode: "lume-control-plane" },
    error: err,
  };
}

export func meta() {
  return {
    service: "cicdkit-lume",
    upstream: exec.runner_base(),
    mode: "native",
    runner_ok: exec.alive(),
    work_dir: jobs.work_dir(),
    llm: llm_get(),
  };
}

// ---------- 总览 ----------

export func overview() {
  let ps = store.list_projects("", 500, 0);
  let rs = store.list_runs("", 200, 0);
  let ds = store.list_deployments("", 200, 0);
  let projects = get(ps, "projects", []);
  let runs = get(rs, "runs", []);
  let deployments = get(ds, "deployments", []);

  let running = 0;
  let failed = 0;
  let i = 0;
  while (i < len(runs)) {
    let st = str(get(runs[i], "status", ""));
    if (st == "running" or st == "queued") { running = running + 1; }
    if (st == "failed" or st == "canceled") { failed = failed + 1; }
    i = i + 1;
  }

  let recent_runs = [];
  i = 0;
  while (i < len(runs) and i < 8) { push(recent_runs, runs[i]); i = i + 1; }
  let recent_deps = [];
  i = 0;
  while (i < len(deployments) and i < 8) { push(recent_deps, deployments[i]); i = i + 1; }
  let redacted = [];
  i = 0;
  while (i < len(projects) and i < 8) { push(redacted, redact.redact_project(projects[i])); i = i + 1; }

  return {
    ok: true,
    upstream: exec.runner_base(),
    connected: exec.alive(),
    projects: int(get(ps, "total", len(projects))),
    runs: int(get(rs, "total", len(runs))),
    deployments: int(get(ds, "total", len(deployments))),
    running: running,
    failed: failed,
    recent_runs: recent_runs,
    recent_deployments: recent_deps,
    recent_projects: redacted,
  };
}

// ---------- 项目 ----------

export func project_list(q, limit, offset) {
  let page = store.list_projects(q, limit, offset);
  let items = get(page, "projects", []);
  let out = [];
  let i = 0;
  while (i < len(items)) {
    let copy = redact.redact_project(items[i]);
    let rel = release.latest(str(get(copy, "id", "")));
    if (rel != null) { put(copy, "last_release", rel); }
    push(out, copy);
    i = i + 1;
  }
  return { projects: out, total: int(get(page, "total", len(out))) };
}

export func project_get(id) {
  let p = store.get_project(id);
  if (p == null) { return { status: 404, body: { ok: false, error: "项目不存在: " + str(id) } }; }
  let copy = redact.redact_project(p);
  let rel = release.latest(str(id));
  if (rel != null) { put(copy, "last_release", rel); }
  return { status: 200, body: copy };
}

// 保存：整份替换（与 cicdkit 的 PUT 语义一致）。
// 顺序很重要——先校验、再回填机密、最后落库；漏掉 merge_secrets 就会
// 把前端回传的 "********" 当成真口令存进去，下次构建 docker login 直接失败。
export func project_put(id, raw) {
  let body = parse_body(raw);
  if (body == null) { return { status: 400, body: { ok: false, error: "请求体不是合法 JSON" } }; }
  if (get(body, "id", null) == null) { put(body, "id", str(id)); }
  let stored = store.get_project(id);
  let incoming = body;
  if (stored != null) { incoming = redact.merge_secrets(body, stored); }
  let err = validate.check_project(incoming, jobs.work_dir());
  if (len(err) > 0) { return { status: 400, body: { ok: false, error: err } }; }
  let old_ts = 0;
  if (stored != null) { old_ts = int(get(stored, "created_ts", 0)); }
  if (old_ts > 0) { put(incoming, "created_ts", old_ts); }
  if (len(str(get(incoming, "created_at", ""))) == 0) { put(incoming, "created_at", store.fmt_iso(now())); }
  put(incoming, "updated_at", store.fmt_iso(now()));
  let w = try(() => store.put_project(incoming, stored == null));
  if (w.err != null) { return { status: 500, body: { ok: false, error: str(w.err) } }; }
  return { status: 200, body: redact.redact_project(store.get_project(id)) };
}

// 新建：id 由前端给（或从 name 推），重名直接拒。
export func project_create(raw) {
  let body = parse_body(raw);
  if (body == null) { return { status: 400, body: { ok: false, error: "请求体不是合法 JSON" } }; }
  let id = trim(s(get(body, "id", ""), ""));
  let name = trim(s(get(body, "name", ""), ""));
  if (len(name) == 0) { return { status: 400, body: { ok: false, error: "name 为必填" } }; }
  if (len(id) == 0) {
    // id 会出现在容器名、run id 里，只保留 [A-Za-z0-9-_.]，其余换 -
    let keep = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.";
    let out = "";
    let i = 0;
    while (i < len(name)) {
      let ch = substr(name, i, 1);
      if (contains(keep, ch)) { out = out + ch; } else { out = out + "-"; }
      i = i + 1;
    }
    id = out;
  }
  if (store.project_exists(id)) { return { status: 409, body: { ok: false, error: "项目已存在: " + id } }; }
  put(body, "id", id);
  return project_put(id, stringify(body));
}

export func project_delete(id) {
  if (not store.project_exists(id)) { return { status: 404, body: { ok: false, error: "项目不存在: " + str(id) } }; }
  let c = store.delete_project_cascade(id);
  return { status: 200, body: { ok: true, deleted: str(id), cascade: c } };
}

// 扫描：把工作目录下「像项目」的目录列出来，用它们的 Dockerfile / manifest 预填表单。
export func project_scan(dir) {
  let root = trim(s(dir, ""));
  if (len(root) == 0) { root = jobs.work_dir(); }
  let err = validate.check_path("dir", jobs.work_dir(), root);
  if (len(err) > 0) { return { status: 400, body: { ok: false, error: err } }; }
  let entries = files(root);
  let out = [];
  let i = 0;
  while (i < len(entries)) {
    let e = str(entries[i]);
    if (len(e) > 0 and substr(e, len(e) - 1) == "/") {
      let raw_name = substr(e, 0, len(e) - 1);
      let path = root;
      if (substr(path, len(path) - 1) == "/") { path = path + raw_name; } else { path = path + "/" + raw_name; }
      let kids = files(path);
      let dockerfile = "";
      let has_git = false;
      let manifests = 0;
      let j = 0;
      while (j < len(kids)) {
        let k = str(kids[j]);
        if (k == "Dockerfile" or k == "dockerfile") { dockerfile = path + "/" + k; }
        if (k == ".git/") { has_git = true; }
        if (k == "deploy/" or k == "k8s/" or k == "chart/" or k == "charts/") { manifests = manifests + 1; }
        j = j + 1;
      }
      if (len(dockerfile) > 0 or manifests > 0) {
        push(out, {
          id: raw_name,
          name: raw_name,
          path: path,
          dockerfile: dockerfile,
          has_git: has_git,
          has_manifests: manifests > 0,
          exists: store.project_exists(raw_name),
        });
      }
    }
    i = i + 1;
  }
  return { status: 200, body: { ok: true, root: root, candidates: out } };
}

// ---------- webhook（外部 CI 触发）----------

// 与 cicdkit 一致：webhook 不参与角色闸门（它是机器调用），靠自己的 key 校验；
// 未设置 CICD_HOOK_KEY 时直接拒绝，避免「忘了配 = 谁都能触发构建」。
// 注意变量名不能含 SECRET/TOKEN（Lume 的 env() 会屏蔽那类名字）。
export func webhook(id, raw, secret) {
  let want = env_str("CICD_HOOK_KEY");
  if (len(want) == 0) { return { status: 503, body: { ok: false, error: "webhook 未启用：请设置 CICD_HOOK_KEY" } }; }
  if (str(secret) != want) { return { status: 401, body: { ok: false, error: "secret 校验失败" } }; }
  if (len(trim(str(id))) == 0) { return { status: 400, body: { ok: false, error: "缺少项目 id" } }; }
  let p = store.get_project(id);
  if (p == null) { return { status: 404, body: { ok: false, error: "项目不存在: " + str(id) } }; }

  let body = parse_body(raw);
  if (body == null) { body = {}; }
  let method = trim(str(get(body, "method", "")));
  if (len(method) > 0 and not validate.method_ok(method)) {
    return { status: 400, body: { ok: false, error: "非法的部署方式覆盖: " + method } };
  }
  let tag = trim(str(get(body, "tag", "")));
  if (not validate.tag_ok(tag)) {
    return { status: 400, body: { ok: false, error: "非法的 tag: " + tag } };
  }
  let tn = trim(str(get(body, "target", "")));
  if (len(tn) > 0) {
    let rd = validate.resolve_deploy(p, tn, method);
    if (not get(rd, "ok", false)) { return { status: 400, body: { ok: false, error: str(get(rd, "err", "目标不存在")) } }; }
  }

  let opts = {
    trigger: "webhook",
    tag: tag,
    method: method,
    target: tn,
    port: trim(str(get(body, "port", ""))),
    image_ref: trim(str(get(body, "image_ref", ""))),
  };
  let r = jobs.start(p, "pipeline", opts);
  if (not get(r, "ok", false)) { return { status: 400, body: { ok: false, error: str(get(r, "err", "")) } }; }
  return {
    status: 202,
    body: { ok: true, run_id: str(get(r, "run_id", "")), image_ref: str(get(r, "image_ref", "")) },
  };
}

// ---------- 脚手架生成（补 Dockerfile / k8s 清单）----------

// apply=false 只预览（前端把内容摆出来让人确认），apply=true 才写盘并回写项目配置。
export func project_generate(id, do_apply) {
  let p = store.get_project(id);
  if (p == null) { return { status: 404, body: { ok: false, error: "项目不存在: " + str(id) } }; }
  let pl = generate.plan(p, jobs.work_dir());
  if (not get(pl, "ok", false)) { return { status: 400, body: { ok: false, error: str(get(pl, "err", "")) } }; }
  if (not do_apply) { return { status: 200, body: pl }; }
  let res = generate.apply(p, jobs.work_dir());
  if (not get(res, "ok", false)) { return { status: 500, body: { ok: false, error: str(get(res, "err", "")) } }; }
  if (not get(res, "needs_any", false)) {
    return { status: 200, body: { ok: true, needs_any: false, message: "Dockerfile 与 k8s 清单均已存在，无需生成" } };
  }
  return { status: 200, body: { ok: true, needs_any: true, plan: res } };
}

// ---------- 动作 ----------

// action: build | pipeline | validate | probe
export func project_action(id, action, raw) {
  let p = store.get_project(id);
  if (p == null) { return { status: 404, body: { ok: false, error: "项目不存在: " + str(id) } }; }
  let body = parse_body(raw);
  if (body == null) { body = {}; }

  if (action == "validate") {
    let err = validate.check_project(p, jobs.work_dir());
    let rd = validate.resolve_deploy(p, "", "");
    return {
      status: 200,
      body: {
        ok: len(err) == 0,
        error: err,
        methods: validate.methods(),
        target: str(get(rd, "target", "")),
        deploy_ok: get(rd, "ok", false),
        deploy_error: str(get(rd, "err", "")),
      },
    };
  }

  if (action == "probe") {
    return probe_run(p, body);
  }

  if (action == "build" or action == "pipeline") {
    let opts = {
      trigger: action,
      target: str(get(body, "target", "")),
      port: str(get(body, "port", "")),
      image_ref: str(get(body, "image_ref", "")),
    };
    let r = jobs.start(p, action, opts);
    if (not get(r, "ok", false)) { return { status: 400, body: { ok: false, error: str(get(r, "err", "")) } }; }
    return { status: 200, body: { ok: true, run_id: str(get(r, "run_id", "")), image_ref: str(get(r, "image_ref", "")) } };
  }

  return { status: 400, body: { ok: false, error: "未知动作: " + str(action) } };
}

// ---------- 整体发布链路 ----------

export func project_release_plan(id) {
  let p = store.get_project(id);
  if (p == null) { return { status: 404, body: { ok: false, error: "项目不存在: " + str(id) } }; }
  let pl = release.plan(p);
  return {
    status: 200,
    body: {
      ok: true,
      project_id: str(get(p, "id", "")),
      project_name: str(get(p, "name", "")),
      stages: get(pl, "stages", []),
      warnings: get(pl, "warnings", []),
      configured: int(get(pl, "configured", 0)),
    },
  };
}

export func project_release_start(id, raw, actor) {
  let p = store.get_project(id);
  if (p == null) { return { status: 404, body: { ok: false, error: "项目不存在: " + str(id) } }; }
  let body = parse_body(raw);
  if (body == null) { body = {}; }
  let r = release.start(p, body, actor);
  if (not get(r, "ok", false)) {
    return {
      status: 400,
      body: { ok: false, error: str(get(r, "err", "整体发布启动失败")), release: get(r, "release", null) },
    };
  }
  return { status: 200, body: { ok: true, release: get(r, "release", null) } };
}

export func project_release_list(id, limit) {
  let p = store.get_project(id);
  if (p == null) { return { status: 404, body: { ok: false, error: "项目不存在: " + str(id) } }; }
  let r = release.list(id, limit);
  return { status: 200, body: r };
}

export func release_get(id) {
  let rel = release.detail(id);
  if (rel == null) { return { status: 404, body: { ok: false, error: "发布链路不存在: " + str(id) } }; }
  return { status: 200, body: { ok: true, release: rel } };
}

export func release_advance(id, raw, actor) {
  let body = parse_body(raw);
  if (body == null) { body = {}; }
  let r = release.advance(id, body, actor);
  if (not get(r, "ok", false)) {
    return {
      status: 409,
      body: { ok: false, error: str(get(r, "err", "推进失败")), release: get(r, "release", null) },
    };
  }
  return { status: 200, body: { ok: true, release: get(r, "release", null) } };
}

export func release_cancel(id, actor) {
  let r = release.cancel(id, actor);
  if (not get(r, "ok", false)) {
    return {
      status: 409,
      body: { ok: false, error: str(get(r, "err", "取消失败")), release: get(r, "release", null) },
    };
  }
  return { status: 200, body: { ok: true, release: get(r, "release", null) } };
}

export func project_deploy(id, raw) {
  let p = store.get_project(id);
  if (p == null) { return { status: 404, body: { ok: false, error: "项目不存在: " + str(id) } }; }
  let body = parse_body(raw);
  if (body == null) { body = {}; }
  let opts = {
    trigger: "deploy",
    target: str(get(body, "target", "")),
    method: str(get(body, "method", "")),
    port: trim(str(get(body, "port", ""))),
    image_ref: str(get(body, "image_ref", "")),
  };
  let r = jobs.start(p, "deploy", opts);
  if (not get(r, "ok", false)) { return { status: 400, body: { ok: false, error: str(get(r, "err", "")) } }; }
  return {
    status: 200,
    body: { ok: true, run_id: str(get(r, "run_id", "")), image_ref: str(get(r, "image_ref", "")), target: str(get(r, "target", "")) },
  };
}

// 回滚发布：取同目标上上一个成功发布的镜像，重新下发一次。
// 走和 deploy 一样的路径（jobs.start），所以审批闸门、argv 拼装、日志、知识库全都复用。
export func project_rollback(id, raw) {
  let p = store.get_project(id);
  if (p == null) { return { status: 404, body: { ok: false, error: "项目不存在: " + str(id) } }; }
  let body = parse_body(raw);
  if (body == null) { body = {}; }
  let want_target = str(get(body, "target", ""));
  let want_image = trim(str(get(body, "image_ref", "")));
  let prev = {};
  if (len(want_image) > 0) {
    // 指定版本时只认这个项目发布历史里真实出现过的镜像：
    // 回滚不该变成"随便发一个镜像"的旁路。
    let versions = store.deploy_versions(id, want_target, 200);
    let found = false;
    let seen_target = "";
    for (v in versions) {
      if (str(get(v, "image_ref", "")) == want_image) { found = true; seen_target = str(get(v, "target", "")); }
    }
    if (not found) {
      return { status: 400, body: { ok: false, error: "镜像不在该项目的发布历史里: " + want_image } };
    }
    // "当前这版"取历史里最新的那条：last_deploy 可能为空（例如库是导入/手写的）
    let cur_img = "";
    if (len(versions) > 0) { cur_img = str(get(versions[0], "image_ref", "")); }
    prev = { ok: true, image_ref: want_image, target: seen_target, current_image: cur_img };
  } else {
    prev = store.prev_deploy(id, want_target);
    if (not bool(get(prev, "ok", false))) {
      return { status: 400, body: { ok: false, error: str(get(prev, "err", "没有可回滚的发布")) } };
    }
  }
  // 没有 targets 的项目，resolve_deploy 会把默认目标命名为 "deploy"；
  // 这个字面名字不能当 targets 里的成员再查一次（会 400「未找到发布目标」），
  // 所以回滚时把它还原成"走默认 deploy 配置"。
  let rtarget = str(get(prev, "target", ""));
  if (rtarget == "deploy") { rtarget = ""; }
  let r = jobs.start(p, "deploy", {
    trigger: "rollback",
    target: rtarget,
    method: "",
    port: trim(str(get(body, "port", ""))),
    image_ref: str(get(prev, "image_ref", "")),
  });
  if (not get(r, "ok", false)) { return { status: 400, body: { ok: false, error: str(get(r, "err", "")) } }; }
  return {
    status: 200,
    body: {
      ok: true,
      run_id: str(get(r, "run_id", "")),
      image_ref: str(get(r, "image_ref", "")),
      target: str(get(r, "target", "")),
      rolled_back_from: str(get(prev, "current_image", "")),
    },
  };
}

// 探测：控制面直接发 HTTP，不经 runner（runner 不装 curl，也不需要）。
// 支持 probe.url 或 body.urls（多地址时逐个试，返回 results）。
func probe_run(p, body) {
  let urls = get(body, "urls", null);
  let one = trim(s(get(body, "url", ""), ""));
  if (len(one) == 0) { one = trim(s(get(get(p, "probe", {}), "url", ""), "")); }
  let list = [];
  if (urls != null) {
    let i = 0;
    while (i < len(urls)) { push(list, str(urls[i])); i = i + 1; }
  }
  if (len(list) == 0 and len(one) > 0) { push(list, one); }
  if (len(list) == 0) { return { status: 400, body: { ok: false, error: "没有可探测的地址（配置 probe.url 或传 url/urls）" } }; }

  let results = [];
  let i = 0;
  while (i < len(list)) {
    let u = str(list[i]);
    let t0 = now();
    let r = null;
    let re = try(() => http_get(u, { timeout: 8, max_bytes: 65536, allow_private: true }));
    let code = 0;
    let err = "";
    if (re.err == null) {
      code = int(get(re.ok, "status", 0));
      err = str(get(re.ok, "err", ""));
    } else {
      err = str(re.err);
    }
    let ms = int((now() - t0) * 1000);
    let st = "down";
    if (code >= 200 and code < 400) { st = "up"; }
    push(results, { url: u, status: st, status_code: code, latency_ms: ms, error: err });
    i = i + 1;
  }
  let first = get(results, 0, {});
  return {
    status: 200,
    body: {
      ok: str(get(first, "status", "down")) == "up",
      probe: first,
      results: results,
    },
  };
}

// ---------- 运行 ----------

export func run_list(project_id, limit, offset) {
  let page = store.list_runs(project_id, limit, offset);
  return { runs: get(page, "runs", []), total: int(get(page, "total", 0)) };
}

export func run_get(id) {
  let r = jobs.sync(id);
  if (r == null) { return { status: 404, body: { ok: false, error: "运行不存在: " + str(id) } }; }
  return { status: 200, body: r };
}

// 日志尾：顺手把状态同步一次（前端只轮询这一个端点）。
export func run_log(id, from) {
  let t = jobs.tail(id, from);
  if (t == null) { return { status: 404, body: { ok: false, error: "运行不存在: " + str(id) } }; }
  let r = get(t, "run", {});
  // 日志里可能带 --build-arg LLM_API_KEY=... / -e *_VISIT_PIN=... 这类真值，
  // 发给浏览器前统一脱敏（磁盘上的原件不动，排障去看文件）。
  put(r, "log", redact.mask_log(str(get(t, "log", ""))));
  put(r, "log_len", get(t, "log_len", 0));
  put(r, "reset", get(t, "reset", false));
  put(r, "truncated", get(t, "truncated", false));
  if (bool(get(t, "truncated", false))) {
    let why = "日志超过 16 MiB（read_file 上限），无法通过接口读取";
    if (len(str(get(t, "log", ""))) > 0) { why = "日志超过 16 MiB（read_file 上限），这里只显示前 16 MiB"; }
    put(r, "log_note", why + "；完整内容在控制面日志目录：" + store.run_log_path(id));
  }
  return { status: 200, body: r };
}

// 归档列表：CICD_RUN_KEEP 裁掉的运行搬到了这里，随时可以恢复。
export func run_archive(limit) {
  let entries = store.list_archive(limit);
  return { status: 200, body: { entries: entries, total: len(entries) } };
}

// 从归档恢复一条运行（连日志一起搬回 logs/）。
export func run_restore(id) {
  let r = store.restore_run(id);
  if (not get(r, "ok", false)) {
    return { status: 404, body: { ok: false, error: str(get(r, "err", "归档里没有这个运行")) } };
  }
  return { status: 200, body: { ok: true, restored: str(id), log_bytes: int(get(r, "log_bytes", 0)) } };
}

// 发布版本列表：前端"回滚到任意一版"用（去重后的历史镜像）。
export func deploy_versions(id, target) {
  let p = store.get_project(id);
  if (p == null) { return { status: 404, body: { ok: false, error: "项目不存在: " + str(id) } }; }
  let entries = store.deploy_versions(id, target, 100);
  return { status: 200, body: { ok: true, entries: entries, total: len(entries) } };
}

export func run_cancel(id) {
  let c = jobs.cancel(id);
  if (not get(c, "ok", false)) { return { status: 400, body: { ok: false, error: str(get(c, "err", "")) } }; }
  return { status: 200, body: { ok: true, canceled: str(id) } };
}

export func run_clear() {
  let n = store.clear_runs();
  return { status: 200, body: { ok: true, deleted: int(n) } };
}

// ---------- 部署历史 ----------

// ---------- 云环境（只读） ----------
//
// 这里只做两件事：
// 1. 按 ssh_host 把项目/target/最近部署聚合起来，给前端一个「云环境」视图。
// 2. 对某个已配置的主机跑一条写死的只读快照命令（docker ps + k3s kubectl 查询）。
// 不接受自由命令，也不通过 Web 暴露交互式 shell。

func env_targets(p) {
  let ts = get(p, "targets", null);
  if (ts != null and len(ts) > 0) { return ts; }
  let d = get(p, "deploy", null);
  if (d != null) { return [d]; }
  return [];
}

func env_bump(g, key) {
  let m = get(g, "environments", {});
  put(m, key, int(get(m, key, 0)) + 1);
  put(g, "environments", m);
}

func env_last_deploy(p, tname) {
  let lds = get(p, "last_deploys", null);
  if (lds != null) {
    if (len(tname) > 0) { return get(lds, tname, null); }
    return get(p, "last_deploy", null);
  }
  // 没有多目标记录时，才把项目级 last_deploy 当作该目标的最近发布。
  return get(p, "last_deploy", null);
}

func env_iso_key(s) {
  let t = str(s);
  if (len(t) < 19 or substr(t, 4, 1) != "-" or substr(t, 7, 1) != "-" or substr(t, 10, 1) != "T") {
    return 0;
  }
  return int(substr(t, 0, 4)) * 10000000000 +
    int(substr(t, 5, 2)) * 100000000 +
    int(substr(t, 8, 2)) * 1000000 +
    int(substr(t, 11, 2)) * 10000 +
    int(substr(t, 14, 2)) * 100 +
    int(substr(t, 17, 2));
}

export func environment_list() {
  let page = store.list_projects("", 1000, 0);
  let items = get(page, "projects", []);
  let by_host = {};
  let order = [];
  let i = 0;
  while (i < len(items)) {
    let p = items[i];
    let targets = env_targets(p);
    let j = 0;
    while (j < len(targets)) {
      let t = targets[j];
      let host = trim(str(get(t, "ssh_host", "")));
      if (len(host) > 0) {
        let g = get(by_host, host, null);
        if (g == null) {
          g = {
            host: host, user: "", port: "", environments: { test: 0, prod: 0, other: 0 },
            projects: [], latest_at: "",
          };
          put(by_host, host, g);
          push(order, host);
        }
        let user = trim(str(get(t, "ssh_user", "")));
        if (len(user) > 0 and len(str(get(g, "user", ""))) == 0) { put(g, "user", user); }
        let port = trim(str(get(t, "ssh_port", "")));
        if (len(port) > 0 and len(str(get(g, "port", ""))) == 0) { put(g, "port", port); }

        let tname = trim(str(get(t, "name", "")));
        let env = validate.target_env(t, tname);
        if (len(env) == 0) { env = "other"; }
        env_bump(g, env);

        let last = env_last_deploy(p, tname);
        let last_at = "";
        if (last != null) { last_at = str(get(last, "at", "")); }
        if (env_iso_key(last_at) > env_iso_key(str(get(g, "latest_at", "")))) {
          put(g, "latest_at", last_at);
        }

        let row = {
          id: str(get(p, "id", "")),
          name: str(get(p, "name", "")),
          target: tname,
          method: str(get(t, "method", "")),
          environment: env,
          port: str(get(t, "ssh_probe_port", "")),
          container_port: str(get(t, "ssh_container_port", "")),
          container: str(get(t, "ssh_container", "")),
          namespace: str(get(t, "namespace", "")),
          release: str(get(t, "release_name", "")),
          last_deploy: last,
          last_status: (last != null ? "success" : ""),
        };
        push(get(g, "projects", []), row);
      }
      j = j + 1;
    }
    i = i + 1;
  }

  let out = [];
  let k = 0;
  while (k < len(order)) {
    let g = get(by_host, get(order, k, ""), null);
    if (g != null) { push(out, g); }
    k = k + 1;
  }
  return { ok: true, environments: out };
}

func find_env_target(host) {
  let want = trim(str(host));
  let page = store.list_projects("", 1000, 0);
  let items = get(page, "projects", []);
  let i = 0;
  while (i < len(items)) {
    let p = items[i];
    let targets = env_targets(p);
    let j = 0;
    while (j < len(targets)) {
      let t = targets[j];
      if (trim(str(get(t, "ssh_host", ""))) == want) {
        return { project: p, target: t };
      }
      j = j + 1;
    }
    i = i + 1;
  }
  return null;
}

export func environment_snapshot(host) {
  let h = trim(str(host));
  if (len(h) == 0) { return { status: 400, body: { ok: false, error: "host 不能为空" } }; }
  let found = find_env_target(h);
  if (found == null) {
    return { status: 404, body: { ok: false, error: "没有项目配置到这个 SSH 主机：" + h } };
  }
  let p = get(found, "project", {});
  let t = get(found, "target", {});
  let argv = ["ssh"];
  let base = exec.ssh_base_args(t);
  let i = 0;
  while (i < len(base)) { push(argv, get(base, i, "")); i = i + 1; }
  let target = exec.ssh_target(t);
  if (len(target) == 0 or substr(target, 0, 1) == "@") {
    return { status: 400, body: { ok: false, error: "该目标的 ssh_user 为空，且没有配置 CICD_SSH_USER" } };
  }
  push(argv, target);
  push(argv, exec.env_snapshot_script());

  let steps = [{ label: "snapshot", argv: argv, timeout_s: 45 }];
  // Helm 发布的目标再补一条 runner 侧 helm list：runner 里有 helm，
  // 并且通过 k3s-tunnel 能访问集群；不依赖宿主机装 helm。
  let hs = exec.helm_list_step(t);
  let k = 0;
  while (k < len(hs)) { push(steps, get(hs, k, {})); k = k + 1; }

  let name = jobs.new_id("env-" + h);
  let sub = exec.submit(name, steps, 90);
  if (not get(sub, "ok", false)) {
    return { status: 502, body: { ok: false, error: str(get(sub, "err", "提交快照任务失败")) } };
  }
  return {
    status: 200,
    body: {
      ok: true, job_id: str(get(sub, "id", "")), host: h,
      project_id: str(get(p, "id", "")), target: str(get(t, "name", "")),
    },
  };
}

func find_env_project(host, project_id, target_name) {
  let h = trim(str(host));
  let pid = trim(str(project_id));
  let tn = trim(str(target_name));
  let p = store.get_project(pid);
  if (p == null) { return null; }
  let targets = env_targets(p);
  let j = 0;
  while (j < len(targets)) {
    let t = targets[j];
    if (trim(str(get(t, "ssh_host", ""))) == h and trim(str(get(t, "name", ""))) == tn) {
      return { project: p, target: t };
    }
    j = j + 1;
  }
  return null;
}

func env_safe_token(s) {
  let v = trim(str(s));
  if (len(v) == 0 or len(v) > 128) { return false; }
  let ok_chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.:/@";
  let i = 0;
  while (i < len(v)) {
    if (not contains(ok_chars, substr(v, i, 1))) { return false; }
    i = i + 1;
  }
  return true;
}

// 云环境受控动作：
// - helm-history / docker-logs 只读
// - rollout-restart / docker-restart 会改变运行状态，路由层要求 human_admin
// 所有参数都从项目配置里取；请求只选“对哪个 target 做哪个动作”。
export func environment_action(host, raw_body, actor) {
  let h = trim(str(host));
  let body = parse_body(raw_body);
  if (body == null) { body = {}; }
  let pid = trim(str(get(body, "project_id", "")));
  let tname = trim(str(get(body, "target", "")));
  let action = trim(str(get(body, "action", "")));
  if (len(pid) == 0 or len(action) == 0) {
    return { status: 400, body: { ok: false, error: "project_id 与 action 不能为空" } };
  }
  let found = find_env_project(h, pid, tname);
  if (found == null) {
    return { status: 404, body: { ok: false, error: "项目 / 目标 / 主机不匹配：" + pid + " / " + tname + " / " + h } };
  }
  let p = get(found, "project", {});
  let t = get(found, "target", {});
  let method = trim(str(get(t, "method", "")));
  let cmd_label = "";
  let steps = [];

  if (action == "helm-history") {
    if (method != "helm") { return { status: 400, body: { ok: false, error: "仅 Helm 目标支持 helm history" } }; }
    let release = trim(str(get(t, "release_name", "")));
    let ns = trim(str(get(t, "namespace", "")));
    let kc = exec.resolve_kubeconfig(t);
    if (not env_safe_token(release) or not env_safe_token(ns) or len(kc) == 0) {
      return { status: 400, body: { ok: false, error: "Helm 目标缺少 release_name / namespace / kubeconfig" } };
    }
    let argv = ["helm", "history", release, "--max", "10", "--kubeconfig", kc];
    if (len(ns) > 0) { push(argv, "-n"); push(argv, ns); }
    steps = [{ label: "helm-history", argv: argv, timeout_s: 30 }];
    cmd_label = "helm history";
  } else if (action == "rollout-restart") {
    if (method != "helm") { return { status: 400, body: { ok: false, error: "仅 Helm 目标支持 rollout restart" } }; }
    let dep = trim(str(get(t, "deployment", "")));
    if (len(dep) == 0) { dep = trim(str(get(t, "release_name", ""))); }
    let ns = trim(str(get(t, "namespace", "")));
    let kc = exec.resolve_kubeconfig(t);
    if (not env_safe_token(dep) or not env_safe_token(ns) or len(kc) == 0) {
      return { status: 400, body: { ok: false, error: "Helm 目标缺少 deployment / namespace / kubeconfig" } };
    }
    let argv = ["kubectl", "rollout", "restart", "deployment/" + dep, "--kubeconfig", kc];
    if (len(ns) > 0) { push(argv, "-n"); push(argv, ns); }
    steps = [{ label: "rollout-restart", argv: argv, timeout_s: 90 }];
    cmd_label = "rollout restart";
  } else if (action == "docker-logs" or action == "docker-restart") {
    if (method != "ssh") { return { status: 400, body: { ok: false, error: "仅 SSH Docker 目标支持容器操作" } }; }
    let c = trim(str(get(t, "ssh_container", "")));
    if (not env_safe_token(c)) {
      return { status: 400, body: { ok: false, error: "该目标没有配置合法的 ssh_container" } };
    }
    let argv = ["ssh"];
    let base = exec.ssh_base_args(t);
    let i = 0;
    while (i < len(base)) { push(argv, get(base, i, "")); i = i + 1; }
    let ssh_to = exec.ssh_target(t);
    if (len(ssh_to) == 0 or substr(ssh_to, 0, 1) == "@") {
      return { status: 400, body: { ok: false, error: "该目标的 ssh_user 为空，且没有配置 CICD_SSH_USER" } };
    }
    push(argv, ssh_to);
    if (action == "docker-logs") {
      push(argv, exec.env_docker_logs_script(c));
      cmd_label = "docker logs";
    } else {
      push(argv, exec.env_docker_restart_script(c));
      cmd_label = "docker restart";
    }
    steps = [{ label: action, argv: argv, timeout_s: 60 }];
  } else {
    return { status: 400, body: { ok: false, error: "不支持的动作：" + action } };
  }

  let name = jobs.new_id("act-" + h);
  let sub = exec.submit(name, steps, 120);
  let ok = bool(get(sub, "ok", false));
  let jid = str(get(sub, "id", ""));
  // 审计先落库：失败也要留“谁尝试过这个动作”，不是只留成功。
  let audit = store.put_env_action({
    host: h, project_id: pid, project_name: str(get(p, "name", "")),
    target: tname, action: action, action_label: cmd_label,
    status: (ok ? "submitted" : "submit_failed"), actor: str(actor),
    job_id: jid, error: str(get(sub, "err", "")),
  });
  if (not ok) {
    return { status: 502, body: { ok: false, error: str(get(sub, "err", "提交动作失败")), audit_id: str(get(audit, "id", "")) } };
  }
  return {
    status: 200,
    body: {
      ok: true, job_id: jid, host: h, project_id: pid, target: tname,
      action: action, audit_id: str(get(audit, "id", "")),
    },
  };
}

export func environment_actions(host, since, until, limit) {
  return store.list_env_actions(host, since, until, limit);
}

export func environment_snapshot_get(job_id) {
  let jid = trim(str(job_id));
  if (len(jid) == 0) { return { status: 400, body: { ok: false, error: "job_id 不能为空" } }; }
  let st = exec.status(jid);
  if (get(st, "missing", true)) {
    return { status: 404, body: { ok: false, error: "任务不存在或 runner 已重启，无法读取输出" } };
  }
  if (not get(st, "ok", false)) {
    return { status: 502, body: { ok: false, error: str(get(st, "err", "runner 不可达")) } };
  }
  let job = get(st, "job", {});
  let js = str(get(job, "status", ""));
  let g = exec.log_range(jid, 0, 262144);
  let log = "";
  // 这里和运行日志走同一个出口：docker logs / helm history 的输出同样可能
  // 带 -e KEY=...、token、连接串。落盘原件不动，回浏览器前统一脱敏。
  if (get(g, "ok", false)) { log = redact.mask_log(str(get(g, "log", ""))); }
  let done = (js == "done" or js == "failed" or js == "canceled" or js == "error");
  let ex = int(get(job, "exit", -1));
  if (done) {
    // 审计行的 status 是提交态；这里回写 runner 终态，避免页面一直显示“已提交”。
    let fin = "failed";
    if (js == "done" and ex == 0) { fin = "success"; }
    if (js == "canceled") { fin = "canceled"; }
    store.finish_env_action(jid, fin, ex);
  }
  return {
    status: 200,
    body: {
      ok: true, job_id: jid, status: js, exit: ex,
      done: done, log: log, log_len: int(get(g, "log_len", 0)),
      error: redact.mask_log(str(get(job, "error", ""))),
    },
  };
}

export func deployment_list(project_id, limit, offset) {
  let page = store.list_deployments(project_id, limit, offset);
  return { deployments: get(page, "deployments", []), total: int(get(page, "total", 0)) };
}

export func deployment_get(id) {
  let d = store.get_deployment(id);
  if (d == null) { return { status: 404, body: { ok: false, error: "部署记录不存在" } }; }
  return { status: 200, body: d };
}

// 部署记录本身不带日志，但它记了 run_id：诊断直接转给那次运行的 diagnose，
// 与上游 /api/deployments/:id/diagnose 语义一致。
export func deployment_diagnose(id) {
  let d = store.get_deployment(id);
  if (d == null) { return { status: 404, body: { ok: false, error: "部署记录不存在" } }; }
  let rid = str(get(d, "run_id", ""));
  if (len(rid) == 0 or store.get_run(rid) == null) {
    return { status: 404, body: { ok: false, error: "找不到该部署对应的运行记录（无法读取日志）" } };
  }
  return run_diagnose(rid);
}

export func deployment_clear() {
  let n = store.clear_deployments();
  return { status: 200, body: { ok: true, deleted: int(n) } };
}

// ---------- 知识库 ----------

export func kb_list(q, limit) {
  return store.list_kb(q, limit);
}

export func kb_add(raw) {
  let body = parse_body(raw);
  if (body == null) { return { status: 400, body: { ok: false, error: "请求体不是合法 JSON" } }; }
  if (len(trim(s(get(body, "diagnosis", ""), ""))) == 0) {
    return { status: 400, body: { ok: false, error: "diagnosis 为必填" } };
  }
  let w = store.put_kb(body);
  if (not get(w, "ok", false)) { return { status: 500, body: { ok: false, error: str(get(w, "err", "")) } }; }
  return { status: 200, body: { ok: true, id: str(get(body, "id", "")) } };
}

export func kb_delete(id) {
  let n = store.delete_kb(id);
  if (int(n) == 0) { return { status: 404, body: { ok: false, error: "条目不存在: " + str(id) } }; }
  return { status: 200, body: { ok: true, deleted: str(id) } };
}

// ---------- SSH 兜底值（表单预填用）----------
// 只回答「有没有配」，不回传私钥路径本身：路径本身不是密钥，但也没必要让
// 浏览器知道（前端只需要判断「这栏能不能留空」）。
func has_env(k) {
  let v = env(k);
  if (v == null) { return false; }
  return len(trim(str(v))) > 0;
}

func env_str(k) {
  let v = env(k);
  if (v == null) { return ""; }
  return trim(str(v));
}

export func ssh_defaults() {
  return {
    user: env_str("CICD_SSH_USER"),
    port: env_str("CICD_SSH_PORT"),
    key_path_set: has_env("CICD_SSH_KEY_PATH"),
    container: env_str("CICD_SSH_CONTAINER"),
    container_port: env_str("CICD_SSH_CONTAINER_PORT"),
    probe_port: env_str("CICD_SSH_PROBE_PORT"),
    // 这里可能含 -e XXX_VISIT_PIN=... 之类真值；接口只给脱敏后的形态。
    run_args: redact.mask_log(env_str("CICD_SSH_RUN_ARGS")),
    command: redact.mask_log(env_str("CICD_SSH_COMMAND")),
  };
}

// ---------- 目录浏览（编辑 build.context 用）----------

export func fs_roots() {
  let raw = env("CICD_FS_ROOTS");
  let out = [];
  if (raw != null and len(trim(str(raw))) > 0) {
    let parts = split(str(raw), ":");
    let i = 0;
    while (i < len(parts)) {
      let t = trim(parts[i]);
      if (len(t) > 0) { push(out, t); }
      i = i + 1;
    }
  }
  if (len(out) == 0) { push(out, jobs.work_dir()); }
  return { roots: out };
}

// 目录浏览的前缀校验。两个坑都踩过（同类实现的经典写法）：
//   1. 只比前缀会让 `/Users/x` 放行 `/Users/xyz`，必须比到 `/` 边界；
//   2. 比前缀不挡 `..`，`/Users/x/../../etc` 前缀仍然成立，
//      拼接后却跑出了允许根——所以含 `..` 一律拒。
func in_root(dir) {
  let d = str(dir);
  if (len(d) == 0 or contains(d, "..")) { return false; }
  let roots = get(fs_roots(), "roots", []);
  let i = 0;
  while (i < len(roots)) {
    let r = str(roots[i]);
    if (substr(r, len(r) - 1) == "/") { r = substr(r, 0, len(r) - 1); }
    if (d == r) { return true; }
    if (len(d) > len(r) and substr(d, 0, len(r)) == r and substr(d, len(r), 1) == "/") { return true; }
    i = i + 1;
  }
  return false;
}

export func fs_list(dir) {
  let roots = get(fs_roots(), "roots", []);
  let d = trim(s(dir, ""));
  if (len(d) == 0) { d = str(get(roots, 0, ".")); }
  // 第一道仍是字符串校验：`..` 直接拒，不用往 runner 跑一趟。
  if (not in_root(d)) {
    return { status: 403, body: { ok: false, error: "目录不在允许范围内: " + d + "（用 CICD_FS_ROOTS 放行）" } };
  }
  // 第二道在 runner 里做：EvalSymlinks 后用真实路径比根，挡软链接逃逸。
  let r = exec.fs_list(d, roots);
  if (not get(r, "ok", false)) {
    let code = int(get(r, "status", 0));
    if (code == 403) { return { status: 403, body: { ok: false, error: str(get(r, "err", "目录不在允许范围内")) } }; }
    if (code == 404) { return { status: 404, body: { ok: false, error: str(get(r, "err", "目录不存在")) } }; }
    return { status: 503, body: { ok: false, error: "目录服务不可用（runner 未就绪）：" + str(get(r, "err", "")) } };
  }
  return { status: 200, body: { dir: str(get(r, "dir", d)), entries: get(r, "entries", []) } };
}

// ---------- 线上访客统计（结构照上游 handleProjectVisits） ----------
//
// 上游从「部署目标的 note」里抓公网域名、从 run_args 里抓 <APP>_VISIT_PIN，
// 然后去应用自己的 /api/visits?pin= 取数据。这套约定是项目配置里写死的，
// 换后端不改协议，所以这里逐字照搬（含 8s 超时与三种返回形态）：
//   configured:false                     未配置 → 前端静默隐藏
//   configured:true, online:false, error 上游不可达 / 非 2xx / 业务错误 → 断线提示
//   configured:true, online:true + 数据   正常
// PIN 是访问凭据：只往 URL 里拼，绝不回显到响应或日志里。

let VISIT_PIN_RE = "([A-Z][A-Z0-9_]*_VISIT_PIN)=([^ \t\r\n]+)";
let VISIT_DOMAIN_RE = "公网域名[ \t]+([^ \t;；,，]+)";

func first_group(text, re, idx) {
  let hits = str_match(re, text);
  if (len(hits) == 0) { return ""; }
  let gs = get(hits[0], "groups", []);
  if (len(gs) <= idx) { return ""; }
  return str(get(gs, idx, ""));
}

func visits_endpoint(p) {
  let url = "";
  let targets = get(p, "targets", []);
  if (targets != null) {
    let i = 0;
    while (i < len(targets)) {
      let note = str(get(targets[i], "note", ""));
      if (len(url) == 0) {
        let dom = first_group(note, VISIT_DOMAIN_RE, 0);
        if (len(dom) > 0) {
          if (substr(dom, 0, 4) == "http") { url = dom; } else { url = "https://" + dom; }
        }
      }
      i = i + 1;
    }
  }
  let pin = "";
  let specs = [get(p, "deploy", {})];
  if (targets != null) {
    let i = 0;
    while (i < len(targets)) {
      push(specs, get(targets[i], "deploy", {}));
      i = i + 1;
    }
  }
  let j = 0;
  while (j < len(specs)) {
    if (len(pin) == 0) { pin = first_group(str(get(specs[j], "ssh_run_args", "")), VISIT_PIN_RE, 1); }
    j = j + 1;
  }
  return { url: url, pin: pin };
}

export func project_visits(id) {
  let p = store.get_project(id);
  if (p == null) { return { status: 404, body: { ok: false, error: "项目不存在" } }; }
  let ep = visits_endpoint(p);
  let url = str(get(ep, "url", ""));
  let pin = str(get(ep, "pin", ""));
  if (len(url) == 0 or len(pin) == 0) { return { status: 200, body: { configured: false } }; }

  let full = url + "/api/visits?pin=" + pin;
  let r = http_get(full, { timeout: 8, allow_private: true, max_bytes: 262144 });
  if (not bool(get(r, "ok", false))) {
    return {
      status: 200,
      body: { configured: true, online: false, url: url, error: "上游不可达: " + str(get(r, "err", "")) },
    };
  }
  let code = int(get(r, "status", 0));
  if (code < 200 or code >= 300) {
    let snip = trim(str(get(r, "body", "")));
    if (len(snip) > 200) { snip = substr(snip, 0, 200) + "…"; }
    return {
      status: 200,
      body: {
        configured: true, online: false, url: url,
        error: "上游 HTTP " + str(code) + "（服务未就绪或 nginx 反代故障）: " + snip,
      },
    };
  }
  let out = store.parse_json(str(get(r, "body", "")), null);
  if (out == null) {
    return {
      status: 200,
      body: { configured: true, online: false, url: url, error: "上游响应解析失败" },
    };
  }
  // lume-core 的 standalone server 对自定义路由固定回 200，PIN 拒绝只能写在
  // 响应体的 status/error 里；别把它当在线数据（否则前端会显示 0）。
  let biz = int(get(out, "status", 0));
  let emsg = trim(str(get(out, "error", "")));
  if (biz >= 400 or len(emsg) > 0) {
    if (len(emsg) == 0) { emsg = "status " + str(biz); }
    return {
      status: 200,
      body: { configured: true, online: false, url: url, error: "上游返回业务错误: " + emsg },
    };
  }
  put(out, "configured", true);
  put(out, "online", true);
  return { status: 200, body: out };
}

// ---------- LLM 配置与诊断 ----------
//
// 配置住在 settings 表的 "llm" 键里（与 cicdkit 的 llm.json 等价）。
// api_key 永不回传：GET 只给 api_key_set；PUT 收到空值或掩码 = 不修改。

func llm_raw() {
  let cfg = store.get_setting("llm");
  if (cfg == null) {
    return { enabled: false, base_url: "https://api.deepseek.com", model: "deepseek-chat", system: "", api_key: "", api_key_set: false };
  }
  if (get(cfg, "api_key_set", null) == null) {
    put(cfg, "api_key_set", len(s(get(cfg, "api_key", ""), "")) > 0);
  }
  return cfg;
}

export func llm_get() {
  let c = llm_raw();
  return {
    enabled: bool(get(c, "enabled", false)),
    base_url: s(get(c, "base_url", ""), ""),
    model: s(get(c, "model", ""), ""),
    system: s(get(c, "system", ""), ""),
    api_key_set: len(s(get(c, "api_key", ""), "")) > 0,
  };
}

export func llm_put(raw) {
  let body = parse_body(raw);
  if (body == null) { return { status: 400, body: { ok: false, error: "请求体不是合法 JSON" } }; }
  let cur = llm_raw();
  let key = s(get(body, "api_key", ""), "");
  if (len(key) == 0 or key == redact.masked()) {
    // 空值 / 掩码 = 沿用旧密钥
    let old = s(get(cur, "api_key", ""), "");
    put(body, "api_key", old);
  }
  let cfg = {
    enabled: bool(get(body, "enabled", false)),
    base_url: s(get(body, "base_url", get(cur, "base_url", "")), ""),
    model: s(get(body, "model", get(cur, "model", "")), ""),
    system: s(get(body, "system", get(cur, "system", "")), ""),
    api_key: s(get(body, "api_key", ""), ""),
  };
  let w = store.put_setting("llm", cfg);
  if (not get(w, "ok", false)) { return { status: 500, body: { ok: false, error: str(get(w, "err", "")) } }; }
  return { status: 200, body: llm_get() };
}

func chat_url(cfg) {
  let base = s(get(cfg, "base_url", "https://api.deepseek.com"), "");
  if (len(base) > 1 and substr(base, len(base) - 1) == "/") { base = substr(base, 0, len(base) - 1); }
  // 末段比较的长度必须等于字面量的字符数：之前这里写 len-9 / len-4，
  // 拿的是「含前一字符的 9/4 位尾巴」，永远不相等，于是 base 已经带 /v1
  // 时又拼了一次 /v1 → 网关收到 /v1/v1/chat/completions 回 404。
  if (len(base) >= 17 and substr(base, len(base) - 17) == "/chat/completions") { return base; }
  if (len(base) >= 3 and substr(base, len(base) - 3) == "/v1") { return base + "/chat/completions"; }
  return base + "/v1/chat/completions";
}

func chat(cfg, sys_prompt, user_prompt, secs, max_tokens) {
  let key = s(get(cfg, "api_key", ""), "");
  if (len(key) == 0) { return { ok: false, status: 0, text: "", err: "未配置 api_key" }; }
  let hdrs = { "Content-Type": "application/json", "Authorization": "Bearer " + key };
  let msgs = [{ role: "user", content: user_prompt }];
  if (len(sys_prompt) > 0) { msgs = [{ role: "system", content: sys_prompt }, { role: "user", content: user_prompt }]; }
  let payload = {
    model: s(get(cfg, "model", "deepseek-chat"), "deepseek-chat"),
    messages: msgs,
    temperature: 0.2,
  };
  if (max_tokens > 0) { put(payload, "max_tokens", max_tokens); }
  let o = { headers: hdrs, timeout: secs, max_bytes: 4194304, body: stringify(payload), allow_private: true };
  let r = null;
  let re = try(() => http_post(chat_url(cfg), o));
  if (re.err != null) { return { ok: false, status: 0, text: "", err: str(re.err) }; }
  r = re.ok;
  let code = int(get(r, "status", 0));
  let data = null;
  let raw = get(r, "body", "");
  if (raw != null and len(str(raw)) > 0) {
    let p = try(() => json(str(raw)));
    if (p.err == null) { data = p.ok; }
  }
  if (code < 200 or code >= 300) {
    let msg = "HTTP " + str(code);
    if (data != null) {
      let e = get(get(data, "error", null), "message", "");
      if (len(str(e)) > 0) { msg = msg + "：" + str(e); }
    }
    return { ok: false, status: code, text: "", err: msg };
  }
  if (data == null) { return { ok: false, status: code, text: "", err: "返回不是 JSON" }; }
  let choices = get(data, "choices", null);
  if (choices == null or len(choices) == 0) { return { ok: false, status: code, text: "", err: "返回里没有 choices" }; }
  let msg = get(get(choices, 0, {}), "message", {});
  return { ok: true, status: code, text: str(get(msg, "content", "")), err: "" };
}

// 供 Text2SQL / Agent 页复用同一份 LLM 配置与 HTTP 调用路径。
// 只读查询同样要受 enabled 控制，避免「诊断没开、Agent 却在偷偷调模型」。
export func llm_chat(sys_prompt, user_prompt, secs, max_tokens) {
  let cfg = llm_raw();
  if (not bool(get(cfg, "enabled", false))) {
    return { ok: false, status: 0, text: "", err: "LLM 未启用，请先到设置页配置并启用" };
  }
  return chat(cfg, sys_prompt, user_prompt, secs, max_tokens);
}

export func llm_test(raw) {
  let body = parse_body(raw);
  if (body == null) { body = {}; }
  let cfg = llm_raw();
  // 允许表单里现填的密钥/地址直接测，不用先保存
  let k = s(get(body, "api_key", ""), "");
  if (len(k) > 0 and k != redact.masked()) { put(cfg, "api_key", k); }
  let b = s(get(body, "base_url", ""), "");
  if (len(b) > 0) { put(cfg, "base_url", b); }
  let m = s(get(body, "model", ""), "");
  if (len(m) > 0) { put(cfg, "model", m); }
  // 60s：网关对部分模型的排队/冷启动会超过 30s，30s 时客户端先超时，
  // 只能看到一个没有意义的 HTTP 0（上游其实已经 200 了）。
  let r = chat(cfg, "", "回复两个字：可用", 60, 0);
  if (not get(r, "ok", false)) { return { status: 200, body: { ok: false, error: str(get(r, "err", "")) } }; }
  return { status: 200, body: { ok: true, reply: str(get(r, "text", "")) } };
}

// 错误行提取：日志里第一条含 error/failed 的行，截断到 120 字。
// 这是 signature 的原料——同类失败要能被认成「同类」。
func error_keyword(log) {
  let lines = split(log, "\n");
  let i = 0;
  while (i < len(lines)) {
    let l = trim(str(lines[i]));
    let lo = lower(l);
    if (contains(lo, "error") or contains(lo, "failed") or contains(lo, "no such") or contains(lo, "denied")) {
      if (len(l) > 120) { return substr(l, 0, 120); }
      return l;
    }
    i = i + 1;
  }
  return "";
}

func last_stage(run) {
  let st = get(run, "stages", null);
  if (st == null or len(st) == 0) { return ""; }
  let i = len(st) - 1;
  return str(get(get(st, i, {}), "name", ""));
}

// 诊断是唯一会把日志发到外部模型、并且同步阻塞 worker 的动作：
// 每人每分钟最多 3 次（同一 run 的重复诊断命中缓存，不计入）。计数器放
// settings 里，重启后最坏多放行 3 次，不值得为此建表。
func diag_rate_ok() {
  let ts = now();
  let raw = store.get_setting("diag_rate");
  let prev = "";
  if (raw != null) { prev = str(raw); }
  let keep = [];
  for (part in split(prev, ",")) {
    let t = int(trim(str(part)));
    if (t > 0 and t > ts - 60) { push(keep, t); }
  }
  if (len(keep) >= 3) { return false; }
  push(keep, ts);
  store.put_setting("diag_rate", join(keep, ","));
  return true;
}

export func run_diagnose(id) {
  let r = jobs.sync(id);
  if (r == null) { return { status: 404, body: { ok: false, error: "运行不存在: " + str(id) } }; }
  let old = get(r, "diagnosis", null);
  if (old != null) {
    // 已经诊断过：直接复用，不重复计费（cicdkit 的行为也是这个）
    if (len(s(get(old, "analysis", ""), "")) > 0) {
      return { status: 200, body: { analysis: str(get(old, "analysis", "")), run_id: str(id), cached: true } };
    }
  }
  if (not diag_rate_ok()) {
    return { status: 429, body: { ok: false, error: "AI 诊断触发过于频繁（每分钟最多 3 次），请稍后再试" } };
  }
  let cfg = llm_raw();
  if (not bool(get(cfg, "enabled", false))) {
    return { status: 400, body: { ok: false, error: "LLM 未启用，请先到设置页配置并启用" } };
  }
  let tail = store.read_log_tail(id, 0, 8000);
  // 送给模型的日志同样先脱敏：诊断不需要真密钥，也不能把它发到第三方端点。
  let log = redact.mask_log(str(get(tail, "log", "")));
  let kw = error_keyword(log);
  let stage = last_stage(r);
  let proj = str(get(r, "project_id", ""));
  let sig = proj + "|" + stage + "|" + kw;
  let hit = store.kb_by_signature(sig);
  if (hit != null) {
    let text = str(get(hit, "diagnosis", ""));
    store.patch_run(id, { diagnosis: { analysis: text, adopted: bool(get(hit, "adopted", false)), cached_from_kb: true, signature: sig } });
    return { status: 200, body: { analysis: text, run_id: str(id), cached: true, cached_from_kb: true, similar: [hit] } };
  }
  let user_prompt = "项目：" + str(get(r, "project_name", proj)) + "\n阶段：" + stage + "\n镜像：" + str(get(r, "image_ref", "")) + "\n状态：" + str(get(r, "status", "")) + "\n\n构建/发布日志（已截断）：\n" + log + "\n\n请用中文回答：最可能的根因是什么？给出 1-3 条可执行的修复步骤。不要泛泛而谈。";
  let sys = s(get(cfg, "system", ""), "你是一名资深 CI/CD 与容器运维工程师，回答要短、具体、可执行。");
  let c = chat(cfg, sys, user_prompt, 150, 0);
  if (not get(c, "ok", false)) {
    return { status: 502, body: { ok: false, error: "模型调用失败：" + str(get(c, "err", "")) } };
  }
  let text = str(get(c, "text", ""));
  store.patch_run(id, { diagnosis: { analysis: text, adopted: false, rejected: false, signature: sig, error_keyword: kw, stage: stage } });
  return { status: 200, body: { analysis: text, run_id: str(id), cached: false, signature: sig, error_keyword: kw } };
}

// 采纳：把结论写进知识库，下次同签名失败直接复用（省一次模型调用）。
export func run_adopt(id, raw) {
  let body = parse_body(raw);
  if (body == null) { body = {}; }
  let adopt = bool(get(body, "adopt", true));
  let r = store.get_run(id);
  if (r == null) { return { status: 404, body: { ok: false, error: "运行不存在: " + str(id) } }; }
  let diag = get(r, "diagnosis", null);
  if (diag == null) { return { status: 400, body: { ok: false, error: "这条运行还没有诊断结果" } }; }
  if (not adopt) {
    put(diag, "rejected", true);
    put(diag, "adopted", false);
    store.patch_run(id, { diagnosis: diag });
    return { status: 200, body: { ok: true, rejected: true } };
  }
  let entry = {
    project_id: str(get(r, "project_id", "")),
    project_name: str(get(r, "project_name", "")),
    stage: str(get(diag, "stage", "")),
    signature: str(get(diag, "signature", "")),
    error_keyword: str(get(diag, "error_keyword", "")),
    error_excerpt: substr(str(get(diag, "error_keyword", "")), 0, 200),
    diagnosis: str(get(diag, "analysis", "")),
    run_id: str(id),
    adopted: true,
    adopted_count: 1,
    adopted_at: store.fmt_iso(now()),
  };
  let w = store.put_kb(entry);
  if (not get(w, "ok", false)) { return { status: 500, body: { ok: false, error: str(get(w, "err", "")) } }; }
  put(diag, "adopted", true);
  put(diag, "rejected", false);
  store.patch_run(id, { diagnosis: diag });
  return { status: 200, body: { ok: true, adopted: true, kb_id: str(get(entry, "id", "")) } };
}
