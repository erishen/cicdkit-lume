// src/redact.lume — 项目配置的脱敏与回填（移植 cicdkit internal/store/validate.go）
//
// 为什么必须有这一层：Project 里混着「运维想看」和「不该出现在浏览器」的字段。
//   build.registry.password   镜像仓库口令
//   deploy.ssh_key_path       私钥绝对路径（泄漏用户名与家目录结构）
//   deploy.kubeconfig         同上
//   deploy.ssh_run_args 里的  <APP>_VISIT_PIN=<pin>（站点访客统计的 owner PIN）
// GET /api/projects 一旦原样返回，这些就进了浏览器缓存与截图。
//
// 回写也要配套：前端拿到的是掩码，PUT 回来时必须保留库里那份真值，
// 否则一次「改个名字保存」就把私钥路径擦成 "********"。这与空值同义（不修改）。

let MASK = "********";

// posix ERE：组 1 = 键名前缀，组 2 = 值
// PIN_RE 只覆盖访客统计；SECRET_ENV_RE 覆盖运行参数里常见的密钥键名。
let PIN_RE = "([A-Z][A-Z0-9_]*_VISIT_PIN=)([^ \t\r\n]+)";
let SECRET_ENV_RE = "([A-Za-z0-9_]*(API_KEY|TOKEN|SECRET|PASSWORD|PASSWD|CREDENTIAL|_PIN)=)([^ \t\r\n'\"&]+)";
let SECRET_KEY_RE = "^[A-Za-z0-9_]*(API_KEY|TOKEN|SECRET|PASSWORD|PASSWD|CREDENTIAL|_PIN)$";

// `secret:<名字>` 是引用，不是明文；清洗脚本必须跳过它，否则会把引用掩码掉。
func looks_like_secret_ref(v) {
  let s = trim(str(v));
  return len(s) >= 7 and substr(s, 0, 7) == "secret:";
}

export func masked() { return MASK; }

// 保留 group 1（键名/前缀），把后面那截值换成掩码。
func mask_env_values(text, re) {
  if (text == null) { return ""; }
  let s = str(text);
  if (len(s) == 0) { return ""; }
  let hits = str_match(re, s);
  if (len(hits) == 0) { return s; }

  let out = "";
  let pos = 0;
  let i = 0;
  while (i < len(hits)) {
    let mo = hits[i];
    let idx = int(get(mo, "index", 0));
    let whole = str(get(mo, "text", ""));
    let gs = get(mo, "groups", []);
    let prefix = "";
    if (len(gs) > 0) { prefix = str(get(gs, 0, "")); }
    if (idx > pos) { out = out + substr(s, pos, idx - pos); }
    out = out + prefix + MASK;
    pos = idx + len(whole);
    i = i + 1;
  }
  if (pos < len(s)) { out = out + substr(s, pos, len(s) - pos); }
  return out;
}

export func mask_visit_pins(s) { return mask_env_values(s, PIN_RE); }
export func mask_secret_env(s) { return mask_env_values(s, SECRET_ENV_RE); }

// 回填：incoming 里带掩码的槽位换回 stored 的真值；未掩码（可能是新值）原样保留。
func restore_env_values(incoming, stored, re, vg) {
  if (incoming == null) { return ""; }
  let inc = str(incoming);
  if (len(inc) == 0) { return ""; }
  if (stored == null) { return inc; }
  let old = str(stored);
  if (len(old) == 0) { return inc; }
  if (not contains(inc, MASK)) { return inc; }

  // 先从真值里收集 prefix -> 真值
  let real = {};
  let olds = str_match(re, old);
  let j = 0;
  while (j < len(olds)) {
    let gs = get(olds[j], "groups", []);
    if (len(gs) > vg) { put(real, str(get(gs, 0, "")), str(get(gs, vg, ""))); }
    j = j + 1;
  }

  let hits = str_match(re, inc);
  if (len(hits) == 0) { return inc; }
  let out = "";
  let pos = 0;
  let i = 0;
  while (i < len(hits)) {
    let mo = hits[i];
    let idx = int(get(mo, "index", 0));
    let whole = str(get(mo, "text", ""));
    let gs = get(mo, "groups", []);
    if (idx > pos) { out = out + substr(inc, pos, idx - pos); }
    let prefix = "";
    let value = "";
    if (len(gs) > vg) { prefix = str(get(gs, 0, "")); value = str(get(gs, vg, "")); }
    let slot = prefix + value;
    if (contains(value, MASK)) {
      let kept = get(real, prefix, null);
      if (kept != null) { slot = prefix + str(kept); }
    }
    out = out + slot;
    pos = idx + len(whole);
    i = i + 1;
  }
  if (pos < len(inc)) { out = out + substr(inc, pos, len(inc) - pos); }
  return out;
}

export func restore_visit_pins(incoming, stored) { return restore_env_values(incoming, stored, PIN_RE, 1); }
export func restore_secret_env(incoming, stored) { return restore_env_values(incoming, stored, SECRET_ENV_RE, 2); }

// 一份可安全返回给浏览器的项目副本（深拷贝后改字段，不动库里的原对象）。
export func redact_project(p) {
  if (p == null) { return null; }
  let copy = json(stringify(p));

  let build = get(copy, "build", null);
  if (build != null) {
    let reg = get(build, "registry", null);
    if (reg != null and len(str(get(reg, "password", ""))) > 0) {
      put(reg, "password", MASK);
    }
    // build_args 里的 LLM_API_KEY 等键，值可能是明文；secret: 引用保持可读。
    let args = get(build, "build_args", null);
    if (args != null) {
      let ks = keys(args);
      let ai = 0;
      while (ai < len(ks)) {
        let k = str(ks[ai]);
        let v = str(get(args, k, ""));
        if (len(str_match(SECRET_KEY_RE, k)) > 0 and len(v) > 0 and v != MASK and not looks_like_secret_ref(v)) {
          put(args, k, MASK);
        }
        ai = ai + 1;
      }
    }
  }

  let dep = get(copy, "deploy", null);
  if (dep != null) {
    if (len(str(get(dep, "ssh_key_path", ""))) > 0) { put(dep, "ssh_key_path", MASK); }
    if (len(str(get(dep, "kubeconfig", ""))) > 0) { put(dep, "kubeconfig", MASK); }
    let ra = str(get(dep, "ssh_run_args", ""));
    if (len(ra) > 0) { put(dep, "ssh_run_args", mask_secret_env(ra)); }
  }

  let targets = get(copy, "targets", null);
  if (targets != null) {
    let i = 0;
    while (i < len(targets)) {
      let t = targets[i];
      if (t != null) {
        if (len(str(get(t, "ssh_key_path", ""))) > 0) { put(t, "ssh_key_path", MASK); }
        if (len(str(get(t, "kubeconfig", ""))) > 0) { put(t, "kubeconfig", MASK); }
        let ra = str(get(t, "ssh_run_args", ""));
        if (len(ra) > 0) { put(t, "ssh_run_args", mask_secret_env(ra)); }
      }
      i = i + 1;
    }
  }
  return copy;
}

// 保持私钥/口令不回退：空值或掩码 = 「不修改」，沿用 stored 里的真值。
export func merge_secrets(incoming, stored) {
  if (incoming == null) { return stored; }
  let p = json(stringify(incoming));
  if (stored == null) { return p; }
  let old = stored;

  let build = get(p, "build", null);
  if (build != null) {
    let reg = get(build, "registry", null);
    if (reg != null) {
      let pw = str(get(reg, "password", ""));
      if (len(pw) == 0 or pw == MASK) {
        let ob = get(old, "build", null);
        if (ob != null) {
          let orr = get(ob, "registry", null);
          if (orr != null) { put(reg, "password", str(get(orr, "password", ""))); }
        }
      }
    }
    let args = get(build, "build_args", null);
    if (args != null) {
      let ob2 = get(old, "build", null);
      let oa = null;
      if (ob2 != null) { oa = get(ob2, "build_args", null); }
      let ks = keys(args);
      let ai = 0;
      while (ai < len(ks)) {
        let k = str(ks[ai]);
        let v = str(get(args, k, ""));
        if ((len(v) == 0 or v == MASK) and oa != null) {
          put(args, k, str(get(oa, k, "")));
        }
        ai = ai + 1;
      }
    }
  }

  let dep = get(p, "deploy", null);
  if (dep != null) {
    let od = get(old, "deploy", null);
    let kp = str(get(dep, "ssh_key_path", ""));
    if (len(kp) == 0 or kp == MASK) {
      if (od != null) { put(dep, "ssh_key_path", str(get(od, "ssh_key_path", ""))); }
    }
    let kc = str(get(dep, "kubeconfig", ""));
    if (len(kc) == 0 or kc == MASK) {
      if (od != null) { put(dep, "kubeconfig", str(get(od, "kubeconfig", ""))); }
    }
    let ra = str(get(dep, "ssh_run_args", ""));
    if (od != null) {
      put(dep, "ssh_run_args", restore_secret_env(ra, str(get(od, "ssh_run_args", ""))));
    }
  }

  let targets = get(p, "targets", null);
  if (targets != null) {
    let ot = get(old, "targets", null);
    let i = 0;
    while (i < len(targets)) {
      let t = targets[i];
      if (t != null) {
        let key = str(get(t, "ssh_key_path", ""));
        if (len(key) == 0 or key == MASK) {
          if (ot != null and i < len(ot)) { put(t, "ssh_key_path", str(get(ot[i], "ssh_key_path", ""))); }
        }
        let kc = str(get(t, "kubeconfig", ""));
        if (len(kc) == 0 or kc == MASK) {
          if (ot != null and i < len(ot)) { put(t, "kubeconfig", str(get(ot[i], "kubeconfig", ""))); }
        }
        let ra = str(get(t, "ssh_run_args", ""));
        if (ot != null and i < len(ot)) {
          put(t, "ssh_run_args", restore_secret_env(ra, str(get(ot[i], "ssh_run_args", ""))));
        }
      }
      i = i + 1;
    }
  }
  return p;
}

// ---------- 运行日志的脱敏 ----------
//
// 为什么在「读」这一侧做：日志里出现密钥是因为它们本来就是构建参数
// （docker build --build-arg LLM_API_KEY=... / docker run -e LLM_API_KEY=...），
// 传值那一刻无法避免；但把日志原样发给浏览器就没必要了。控制面读日志尾时
// 统一过一遍 mask_log()，落盘的原始日志仍保留，排障时可以去看原件。
//
// runner 侧不解释内容，所以脱敏只能在这一层做——这也是 runner 保持愚蠢的代价之一。

let SECRET_RE = "([A-Za-z0-9_]*(API_KEY|TOKEN|SECRET|PASSWORD|PASSWD|CREDENTIAL|_PIN)=)([^ \t\r\n'\"&]+)";
let KEY_RE = "(sk-)[A-Za-z0-9_-]{12,}";
// 常见代码托管/IM/云厂商的 token 形态：只保留前缀，后面整段打码。
let PROVIDER_RE = "(ghp_|gho_|ghu_|ghs_|ghr_|glpat-|xoxb-|xoxp-|xoxa-|xoxr-|xoxs-)([A-Za-z0-9_-]{10,})";
let AWS_RE = "(AKIA|ASIA)([A-Z0-9]{12,})";
let BEARER_RE = "(Bearer[ \t]+)([A-Za-z0-9._-]{16,})";

// 保留 group 1（键名/前缀），把后面那截值换成掩码。
func mask_after_prefix(text, re) {
  let hits = str_match(re, text);
  if (len(hits) == 0) { return text; }
  let out = "";
  let pos = 0;
  let i = 0;
  while (i < len(hits)) {
    let mo = hits[i];
    let idx = int(get(mo, "index", 0));
    let whole = str(get(mo, "text", ""));
    let gs = get(mo, "groups", []);
    let prefix = "";
    if (len(gs) > 0) { prefix = str(get(gs, 0, "")); }
    if (idx > pos) { out = out + substr(text, pos, idx - pos); }
    out = out + prefix + MASK;
    pos = idx + len(whole);
    i = i + 1;
  }
  if (pos < len(text)) { out = out + substr(text, pos, len(text) - pos); }
  return out;
}

// ---------- 项目配置里的明文密钥清洗 ----------
//
// 与 mask_log 的区别：那个只处理「日志文本」里的 `K=V`，且是给人看的；
// 这里处理的是**已经解析好的项目 JSON**，要能认出两种形态：
//   1) 字符串里内嵌 `LLM_API_KEY=sk-...`（`--build-arg` / `-e` 拼成的参数）
//   2) map 形态的 `build_args: {LLM_API_KEY: "sk-..."}`（值本身就是密钥）
// 形态 2 必须整值换成掩码，否则会留下 `sk-********` 这种带前缀的残形。
// 递归改写 node（就地改 map/list），命中路径与条数记在 acc（acc = {n, items}）。
// 没有 typeof/is_map 内建，所以用「试探调用」判别容器：keys() 只在 map 上成功、
// substr() 只在 string 上成功，两者都失败就当标量。
export func mask_values(node, path, acc) {
  if (node == null) { return node; }

  let km = try(() => keys(node));
  if (km.err == null) {
    let ks = km.ok;
    let i = 0;
    while (i < len(ks)) {
      let k = str(ks[i]);
      let child = get(node, k, null);
      if (len(str_match(SECRET_KEY_RE, k)) > 0 and child != null and len(str(child)) > 0 and str(child) != MASK and not looks_like_secret_ref(child)) {
        put(node, k, MASK);
        put(acc, "n", int(get(acc, "n", 0)) + 1);
        push(get(acc, "items", []), path + "." + k);
      } else {
        put(node, k, mask_values(child, path + "." + k, acc));
      }
      i = i + 1;
    }
    return node;
  }

  let ss = try(() => substr(node, 0, 0));
  if (ss.err == null) {
    let s = str(node);
    let masked = mask_log(s);
    if (masked != s) {
      put(acc, "n", int(get(acc, "n", 0)) + 1);
      push(get(acc, "items", []), path);
      return masked;
    }
    return node;
  }

  let ln = try(() => len(node));
  if (ln.err == null) {
    let out = [];
    let i = 0;
    while (i < len(node)) {
      push(out, mask_values(node[i], path + "[" + str(i) + "]", acc));
      i = i + 1;
    }
    return out;
  }
  return node;
}

export func mask_log(text) {
  if (text == null) { return ""; }
  let s = str(text);
  if (len(s) == 0) { return ""; }
  s = mask_after_prefix(s, SECRET_RE);
  s = mask_after_prefix(s, KEY_RE);
  s = mask_after_prefix(s, PROVIDER_RE);
  s = mask_after_prefix(s, AWS_RE);
  s = mask_after_prefix(s, BEARER_RE);
  return s;
}
